{"file":"pending-DB6NrBdv.js","mappings":";;;;;;;;;;;;;;;;;;;;;AAGA,eAAW,EAAE,OAAO,oCAAoC,QAAQ,WAAW;AAE1D,sBAAA;AACjB,UAAM,EAAE,QAAA,IAAY,cAAA;;mBASbA,eAAAC,WAAA,EAAA,OAAM,mEAA+D,MAAA,CAAA,6ZAQ1DC,MAAA,OAAA,CAAO;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref"],"sources":["../../../../../../../app/pages/pending.vue"],"sourcesContent":["<script setup lang=\"ts\">\ndefinePageMeta({ layout: false })\n\nuseSeoMeta({ title: 'Pending Approval | Alumni Portal', robots: 'noindex' })\n\nconst supabase = useSupabaseClient()\nconst { appName } = useSiteConfig()\n\nasync function handleSignOut() {\n  await supabase.auth.signOut()\n  navigateTo('/login')\n}\n</script>\n\n<template>\n  <div class=\"min-h-screen flex items-center justify-center bg-slate-50 p-4\">\n    <div class=\"max-w-md w-full text-center\">\n      <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-10\">\n        <div class=\"w-20 h-20 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-6\">\n          <i class=\"pi pi-clock text-yellow-600 text-3xl\" />\n        </div>\n        <h1 class=\"text-2xl font-bold text-slate-900 mb-3\">Pending Approval</h1>\n        <p class=\"text-slate-500 leading-relaxed mb-6\">\n          Your {{ appName }} account is under review. An administrator will approve your membership soon.\n          You'll be able to access the alumni portal once approved.\n        </p>\n        <button\n          class=\"text-sm text-slate-500 hover:text-red-600 transition-colors\"\n          @click=\"handleSignOut\"\n        >\n          Sign out\n        </button>\n      </div>\n    </div>\n  </div>\n</template>\n"],"version":3}