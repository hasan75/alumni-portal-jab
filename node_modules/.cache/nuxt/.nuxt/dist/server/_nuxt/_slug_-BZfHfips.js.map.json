{"file":"_slug_-BZfHfips.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAGA,UAAM,QAAQ;AAWsB,cAAA;AACtB,aAAA;AACd,UAAM,UAAU,IAAI,KAAK;AAEzB,UAAM,YAAY,SAAS,MAAM;AAC/B,UAAI,CAAC,MAAM,aAAc,QAAO;AAChC,aAAO,IAAI,KAAK,MAAM,YAAY,wBAAQ,KAAA;AAAA,IAC5C,CAAC;;AA2BY,UAAA,QAAA,gBAAgBA,MAAA,SAAA,GAAS;AAAE,cAAA,OAAAC,eAAAC,WAAA,EAAA,OAAM,gBAAY,MAAA,CAAA,CAAA,WAAA;AAEnCC,sBAAA;AAAA;;;WAIhB,CAJM,WAAM;;YAOK,QAAA,aAAa,WAAW,OAAO;qIAKtCH,MAAA,OAAA,CAAO,IAAA,cAAA,gBAGPI,eAAA,CAAA,OAAO,MAAI,SAAA,CAAA,WACnBC,eAAA,OAAO,KAAK;;;iBAGLL,MAAA,SAAA,GAAS;AAAE,cAAA,KAAAC,eAAAC,WAAA,EAAA,OAAM,4BAAwB,MAAA,CAAA,CAAA,iCAAA;AAAA;;;;;;;;;;;;;;;;;;ACjEzD,UAAM,QAAQ,SAAA;AACd,UAAM,OAAO,MAAM,OAAO;AAE1B,UAAM,EAAE,aAAa,oBAAA,IAAwB,UAAA;AAC7C,UAAM,OAAO,gBAAA;AAEb,UAAM,EAAE,MAAM,OAAO,aAAY,CAAA,QAAA,SAAA,IAAAI,iBAAA,MAAM,aAAa,SAAS,IAAI,IAAI,MAAM,YAAY,IAAI,CAAC,CAAA;AAE5F,QAAI,CAAC,MAAM,SAAS,CAAC,QAAQ,OAAO;AAClC,YAAM,YAAY,EAAE,YAAY,KAAK,eAAe,mBAAmB;AAAA,IACzE;AAEA,UAAM,SAAS,IAAI,IAAI;AACvB,QAAI,KAAK,SAAS,MAAM,OAAO;AAC7B,aAAO,SAAQ,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM,oBAAoB,MAAM,MAAM,EAAE,CAAA;IACzD;AAEA,eAAW;AAAA,MACT,OAAO,SAAS,MAAM,GAAG,MAAM,OAAO,SAAS,OAAO,kBAAkB;AAAA,MACxE,aAAa,SAAS,MAAM,MAAM,OAAO,eAAe,EAAE;AAAA,IAAA,CAC3D;;;AAIM,YAAA,OAAAL,eAAAC,WAAA,EAAA,OAAM,iCAA6B,MAAA,CAAA,CAAA,GAAA;;QAC5B,IAAG;AAAA,QAAU,OAAM;AAAA,MAAA;yBAA7B,CAGW,GAAAK,QAAAC,UAAA,aAAA;;;;;cAFTC,YAAsC,KAAA,EAAnC,OAAM,4BAA0B;AAAA,8BAAG,kBAExC;AAAA,YAAA;AAAA;;;;UAEWT,MAAA,OAAA,GAAO;;iBAEFA,MAAA,KAAA,GAAK;;AAGN,YAAAA,MAAA,KAAA,EAAM,iBAAe;qCAAG,OAAKA,MAAA,KAAA,EAAM,eAAe,kBAAG,OAAKA,MAAA,KAAA,EAAM,KAAK;;;;iPAOvEK,eAAAL,MAAA,KAAA,EAAM,UAAU,8DAEiCK,eAAAL,MAAA,KAAA,EAAM,KAAK;YAG3DA,MAAA,IAAA,GAAI;;YACT,YAAUA,MAAA,KAAA,EAAM;AAAA,YAChB,gBAAcA,MAAA,MAAA;AAAA,YACd,gBAAcA,MAAA,KAAA,EAAM;AAAA,YACpB,iBAAeA,MAAA,KAAA,EAAM;AAAA,YACrB,UAAM,CAAG,MAAM,OAAA,QAAS,IAAC,EAAA,IAAA,GAAA,UAAsBA,MAAA,KAAA,EAAO,IAAE,WAAaA,MAAA,IAAA,EAAM,YAAY,GAAC,YAAA,OAAA;AAAA,UAAA;;;YAE1E,IAAG;AAAA,YAAS,OAAM;AAAA,UAAA;6BAAnC,CAEW,GAAAO,QAAAC,UAAA,aAAA;;;;;kCAF6F,mBAExG;AAAA,gBAAA;AAAA;;;;;+MAMWR,MAAA,cAAA,EAAeA,MAAA,KAAA,EAAM,cAAc,CAAA,CAAA,eAAA;AAEnC,YAAAA,MAAA,KAAA,EAAM,cAAY;sJAEZA,MAAA,cAAA,EAAeA,MAAA,KAAA,EAAM,YAAY,CAAA,CAAA,eAAA;AAAA;;;AAEvC,YAAAA,MAAA,KAAA,EAAM,iBAAiBA,MAAA,KAAA,EAAM,WAAS;yFACpCI,eAAA,CAAAJ,MAAA,KAAA,EAAM,YAAS,gBAAA,oBAAA,kBAAA,CAAA,gBACjBK,eAAAL,MAAA,KAAA,EAAM,YAAS,WAAcA,MAAA,KAAA,EAAM,aAAa;;;;AAEhD,YAAAA,MAAA,KAAA,EAAM,aAAU,GAAA;AAEhB,gBAAA,iHAAAK,eAAAL,MAAA,KAAA,EAAM,UAAU,CAAA,yBAAA;AAAA;;;;AAIlB,YAAAA,MAAA,KAAA,EAAM,aAAW;AACmB,gBAAA,8FAAAK,eAAAL,MAAA,KAAA,EAAM,WAAW,CAAA,YAAA;AAAA;;;AAGrD,YAAAA,MAAA,KAAA,EAAM,SAAO;AAA+D,gBAAA,6DAAAA,MAAA,KAAA,EAAM,WAAO,EAAA,QAAA;AAAA;;;;;;;;;;;;;;;;;","names":["_unref","_ssrRenderAttrs","_mergeProps","_ssrRenderList","_ssrRenderClass","_ssrInterpolate","_withAsyncContext","_push","_parent","_createVNode"],"sources":["../../../../../../../app/components/events/RsvpButton.vue","../../../../../../../app/pages/events/[slug].vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { EventRsvp, RsvpStatus } from '~/types/event'\n\nconst props = defineProps<{\n  eventId: number\n  currentRsvp: EventRsvp | null\n  rsvpEnabled: boolean\n  rsvpDeadline?: string | null\n}>()\n\nconst emit = defineEmits<{\n  change: [status: RsvpStatus | null]\n}>()\n\nconst { rsvpToEvent, removeRsvp } = useEvents()\nconst toast = useToast()\nconst loading = ref(false)\n\nconst isExpired = computed(() => {\n  if (!props.rsvpDeadline) return false\n  return new Date(props.rsvpDeadline) < new Date()\n})\n\nasync function handleRsvp(status: RsvpStatus) {\n  if (loading.value) return\n  loading.value = true\n\n  if (props.currentRsvp?.status === status) {\n    // Toggle off\n    const result = await removeRsvp(props.eventId)\n    if (result.success) {\n      emit('change', null)\n      toast.add({ severity: 'info', summary: 'RSVP removed', life: 2000 })\n    }\n  }\n  else {\n    const result = await rsvpToEvent(props.eventId, status)\n    if (result.success) {\n      emit('change', status)\n      toast.add({ severity: 'success', summary: 'RSVP updated', life: 2000 })\n    }\n  }\n\n  loading.value = false\n}\n</script>\n\n<template>\n  <div v-if=\"rsvpEnabled && !isExpired\" class=\"flex gap-2\">\n    <button\n      v-for=\"option in [\n        { status: 'going' as RsvpStatus, label: 'Going', icon: 'pi pi-check' },\n        { status: 'maybe' as RsvpStatus, label: 'Maybe', icon: 'pi pi-question' },\n        { status: 'not_going' as RsvpStatus, label: 'Can\\'t Go', icon: 'pi pi-times' },\n      ]\"\n      :key=\"option.status\"\n      class=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition-all border\"\n      :class=\"[\n        currentRsvp?.status === option.status\n          ? 'bg-primary-600 text-white border-primary-600'\n          : 'bg-white text-slate-600 border-slate-200 hover:border-primary-300',\n      ]\"\n      :disabled=\"loading\"\n      @click=\"handleRsvp(option.status)\"\n    >\n      <i :class=\"option.icon\" class=\"text-xs\" />\n      {{ option.label }}\n    </button>\n  </div>\n  <p v-else-if=\"isExpired\" class=\"text-sm text-slate-500\">\n    RSVP deadline has passed\n  </p>\n</template>\n","<script setup lang=\"ts\">\nimport RsvpButton from '~/components/events/RsvpButton.vue'\nimport { formatDateTime, formatDateShort } from '~/utils/formatters'\n\nconst route = useRoute()\nconst slug = route.params.slug as string\n\nconst { fetchBySlug, fetchMyRsvpForEvent } = useEvents()\nconst user = useSupabaseUser()\n\nconst { data: event, pending } = await useAsyncData(`event-${slug}`, () => fetchBySlug(slug))\n\nif (!event.value && !pending.value) {\n  throw createError({ statusCode: 404, statusMessage: 'Event not found' })\n}\n\nconst myRsvp = ref(null)\nif (user.value && event.value) {\n  myRsvp.value = await fetchMyRsvpForEvent(event.value.id)\n}\n\nuseSeoMeta({\n  title: computed(() => `${event.value?.title || 'Event'} | Alumni Portal`),\n  description: computed(() => event.value?.description || ''),\n})\n</script>\n\n<template>\n  <div class=\"max-w-3xl mx-auto px-4 py-8\">\n    <NuxtLink to=\"/events\" class=\"inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-primary-600 mb-4\">\n      <i class=\"pi pi-arrow-left text-xs\" />\n      Back to Events\n    </NuxtLink>\n\n    <div v-if=\"pending\" class=\"bg-white border border-slate-200 rounded-xl h-96 animate-pulse\" />\n\n    <div v-else-if=\"event\" class=\"space-y-4\">\n      <!-- Cover -->\n      <div class=\"bg-gradient-to-br from-primary-600 to-primary-800 rounded-xl h-48 overflow-hidden\">\n        <img v-if=\"event.cover_image_url\" :src=\"event.cover_image_url\" :alt=\"event.title\" class=\"w-full h-full object-cover\">\n      </div>\n\n      <div class=\"bg-white border border-slate-200 rounded-xl p-6\">\n        <div class=\"flex items-start justify-between gap-4 flex-wrap\">\n          <div>\n            <span class=\"text-xs font-medium text-primary-700 bg-primary-50 px-2 py-0.5 rounded-full\">\n              {{ event.event_type }}\n            </span>\n            <h1 class=\"text-2xl font-bold text-slate-900 mt-2\">{{ event.title }}</h1>\n          </div>\n          <RsvpButton\n            v-if=\"user\"\n            :event-id=\"event.id\"\n            :current-rsvp=\"myRsvp\"\n            :rsvp-enabled=\"event.rsvp_enabled\"\n            :rsvp-deadline=\"event.rsvp_deadline\"\n            @change=\"(s) => myRsvp = s ? { id: 0, event_id: event!.id, alumni_id: user!.id, status: s, created_at: '' } : null\"\n          />\n          <NuxtLink v-else to=\"/login\" class=\"px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-lg\">\n            Sign in to RSVP\n          </NuxtLink>\n        </div>\n\n        <div class=\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3\">\n          <div class=\"flex items-center gap-2 text-sm text-slate-600\">\n            <i class=\"pi pi-calendar text-primary-500\" />\n            <span>{{ formatDateTime(event.start_datetime) }}</span>\n          </div>\n          <div v-if=\"event.end_datetime\" class=\"flex items-center gap-2 text-sm text-slate-600\">\n            <i class=\"pi pi-clock text-primary-500\" />\n            <span>Ends: {{ formatDateTime(event.end_datetime) }}</span>\n          </div>\n          <div v-if=\"event.location_name || event.is_online\" class=\"flex items-center gap-2 text-sm text-slate-600\">\n            <i :class=\"event.is_online ? 'pi pi-video' : 'pi pi-map-marker'\" class=\"text-primary-500\" />\n            <span>{{ event.is_online ? 'Online' : event.location_name }}</span>\n          </div>\n          <div v-if=\"event.rsvp_count > 0\" class=\"flex items-center gap-2 text-sm text-slate-600\">\n            <i class=\"pi pi-users text-primary-500\" />\n            <span>{{ event.rsvp_count }} attending</span>\n          </div>\n        </div>\n\n        <div v-if=\"event.description\" class=\"mt-4 pt-4 border-t border-slate-100\">\n          <p class=\"text-slate-700 leading-relaxed\">{{ event.description }}</p>\n        </div>\n\n        <div v-if=\"event.content\" class=\"mt-4 prose max-w-none text-sm text-slate-700\" v-html=\"event.content\" />\n      </div>\n    </div>\n  </div>\n</template>\n"],"version":3}