Q,4BAAnBG,YAWM,OAAA;AAAA;kBAX0B,OAAM;AAAA,gBAAA;kBAE5B,QAAA,QAAQ,kCADhBA,YAKC,OAAA;AAAA;oBAHE,KAAK,QAAA,QAAQ;AAAA,oBACd,OAAM;AAAA,oBACN,KAAI;AAAA,kBAAA;kBAEND,YAAsC,QAAA,MAAAE,gBAA7B,QAAA,QAAQ,WAAW,GAAA,CAAA;AAAA,kBAChB,QAAA,QAAQ,qCAApBD,YAEO,QAAA;AAAA;oBAFmC,OAAM;AAAA,kBAAA,GAAiB,QAC7DC,gBAAG,QAAA,QAAQ,oBAAoB,IAAG,cACtC,CAAA;;;;;;;;;;;;;;;;;;","names":["_push","_parent","_ssrRenderStyle","_unref","_ssrInterpolate","_createVNode","_createBlock","_toDisplayString"],"sources":["../../../../../../../app/components/news/ArticleCard.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { Article } from '~/types/news'\nimport { formatDateShort, truncate } from '~/utils/formatters'\n\ndefineProps<{\n  article: Article\n  featured?: boolean\n}>()\n</script>\n\n<template>\n  <NuxtLink\n    :to=\"`/news/${article.slug}`\"\n    class=\"bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-primary-200 hover:shadow-sm transition-all block\"\n    :class=\"featured ? 'md:flex' : ''\"\n  >\n    <!-- Image -->\n    <div\n      class=\"bg-slate-100 relative overflow-hidden\"\n      :class=\"featured ? 'md:w-64 h-48 md:h-auto shrink-0' : 'h-44'\"\n    >\n      <img\n        v-if=\"article.featured_image_url\"\n        :src=\"article.featured_image_url\"\n        :alt=\"article.title\"\n        class=\"w-full h-full object-cover\"\n      >\n      <div v-else class=\"w-full h-full flex items-center justify-center text-slate-400\">\n        <i class=\"pi pi-image text-3xl\" />\n      </div>\n      <div v-if=\"article.is_breaking\" class=\"absolute top-2 left-2\">\n        <span class=\"text-[10px] font-bold text-white bg-red-500 px-2 py-0.5 rounded-full uppercase tracking-wide\">\n          Breaking\n        </span>\n      </div>\n    </div>\n\n    <!-- Content -->\n    <div class=\"p-4\">\n      <div class=\"flex items-center gap-2 mb-2\">\n        <span\n          v-if=\"article.category\"\n          class=\"text-[11px] font-medium px-2 py-0.5 rounded-full\"\n          :style=\"article.category.color ? `background: ${article.category.color}20; color: ${article.category.color}` : ''\"\n          :class=\"article.category.color ? '' : 'bg-primary-50 text-primary-700'\"\n        >\n          {{ article.category.name }}\n        </span>\n        <span class=\"text-[11px] text-slate-400\">{{ formatDateShort(article.published_at) }}</span>\n      </div>\n\n      <h3\n        class=\"font-semibold text-slate-900 leading-snug\"\n        :class=\"featured ? 'text-lg' : ''\"\n      >\n        {{ article.title }}\n      </h3>\n\n      <p v-if=\"article.excerpt\" class=\"text-sm text-slate-600 mt-1.5 leading-relaxed\">\n        {{ truncate(article.excerpt, featured ? 200 : 100) }}\n      </p>\n\n      <div v-if=\"article.author_name\" class=\"mt-3 flex items-center gap-1.5 text-xs text-slate-500\">\n        <img\n          v-if=\"article.author_avatar_url\"\n          :src=\"article.author_avatar_url\"\n          class=\"w-5 h-5 rounded-full object-cover\"\n          alt=\"Author\"\n        >\n        <span>{{ article.author_name }}</span>\n        <span v-if=\"article.reading_time_minutes\" class=\"text-slate-400\">\n          · {{ article.reading_time_minutes }} min read\n        </span>\n      </div>\n    </div>\n  </NuxtLink>\n</template>\n"],"version":3}