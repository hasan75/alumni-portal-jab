AQnC,IAAG;AAAA,QAAa,OAAM;AAAA,MAAA;yBAAhC,CAAgG,GAAAF,QAAAC,UAAA,aAAA;;;;;8BAA3B,kBAAgB;AAAA,YAAA;AAAA;;;;;;QAC3E,IAAG;AAAA,QAAU,OAAM;AAAA,MAAA;yBAA7B,CAAmF,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAAjB,QAAM;AAAA,YAAA;AAAA;;;;;;QAC9D,IAAG;AAAA,QAAQ,OAAM;AAAA,MAAA;yBAA3B,CAA+E,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAAf,MAAI;AAAA,YAAA;AAAA;;;;;;QAC1D,IAAG;AAAA,QAAQ,OAAM;AAAA,MAAA;yBAA3B,CAAoF,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAApB,WAAS;AAAA,YAAA;AAAA;;;;;;QAQ/D,IAAG;AAAA,QAAS,OAAM;AAAA,MAAA;yBAA5B,CAAmF,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAAlB,SAAO;AAAA,YAAA;AAAA;;;;;;QAC9D,IAAG;AAAA,QAAY,OAAM;AAAA,MAAA;yBAA/B,CAAuF,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAAnB,UAAQ;AAAA,YAAA;AAAA;;;;;;QAClE,IAAG;AAAA,QAAQ,OAAM;AAAA,MAAA;yBAA3B,CAAsF,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAAtB,aAAW;AAAA,YAAA;AAAA;;;;;;QACjE,IAAG;AAAA,QAAW,OAAM;AAAA,MAAA;yBAA9B,CAAwF,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAArB,YAAU;AAAA,YAAA;AAAA;;;;mLAOrEI,gBAAA,oBAAA,KAAA,GAAO,YAAA,CAAW,oBAASH,MAAA,eAAA,CAAe;;;;;;;;;;;;;;;;ACxC3D,YAAA,OAAAJ,eAAAC,WAAA,EAAA,OAAM,gCAA4B,MAAA,CAAA,CAAA,GAAA;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_unref","_createVNode","_ssrRenderList","_ssrInterpolate","_createTextVNode","_toDisplayString"],"sources":["../../../../../../../app/components/layouts/header.vue","../../../../../../../app/components/layouts/footer.vue","../../../../../../../app/layouts/default.vue"],"sourcesContent":["<script setup lang=\"ts\">\nconst user = useSupabaseUser()\nconst route = useRoute()\nconst { appName } = useSiteConfig()\n\nconst mobileMenuOpen = ref(false)\n\nconst publicNavItems = [\n  { label: 'Events', to: '/events' },\n  { label: 'News', to: '/news' },\n  { label: 'Jobs', to: '/jobs' },\n  { label: 'Directory', to: '/directory' },\n]\n\nfunction isActive(path: string) {\n  return route.path === path || route.path.startsWith(`${path}/`)\n}\n</script>\n\n<template>\n  <header class=\"bg-white border-b border-slate-200 sticky top-0 z-30\">\n    <div class=\"max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-4\">\n      <!-- Logo -->\n      <NuxtLink to=\"/\" class=\"flex items-center gap-2 shrink-0\">\n        <div class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-primary-600 text-white font-bold\">\n          A\n        </div>\n        <span class=\"font-bold text-slate-900 text-lg hidden sm:inline\">{{ appName }}</span>\n      </NuxtLink>\n\n      <!-- Desktop nav -->\n      <nav class=\"hidden md:flex items-center gap-1\">\n        <NuxtLink\n          v-for=\"item in publicNavItems\"\n          :key=\"item.to\"\n          :to=\"item.to\"\n          class=\"px-3 py-2 rounded-lg text-sm font-medium transition-colors\"\n          :class=\"[\n            isActive(item.to)\n              ? 'text-primary-700 bg-primary-50'\n              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50',\n          ]\"\n        >\n          {{ item.label }}\n        </NuxtLink>\n      </nav>\n\n      <!-- Right: Auth buttons -->\n      <div class=\"flex items-center gap-2\">\n        <template v-if=\"user\">\n          <NuxtLink\n            to=\"/feed\"\n            class=\"px-4 py-2 rounded-lg bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors\"\n          >\n            My Portal\n          </NuxtLink>\n        </template>\n        <template v-else>\n          <NuxtLink\n            to=\"/login\"\n            class=\"px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors\"\n          >\n            Sign In\n          </NuxtLink>\n          <NuxtLink\n            to=\"/register\"\n            class=\"px-4 py-2 rounded-lg bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors\"\n          >\n            Join Now\n          </NuxtLink>\n        </template>\n        <button\n          class=\"md:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-50\"\n          @click=\"mobileMenuOpen = !mobileMenuOpen\"\n        >\n          <i class=\"pi pi-bars\" />\n        </button>\n      </div>\n    </div>\n\n    <!-- Mobile menu -->\n    <div v-if=\"mobileMenuOpen\" class=\"md:hidden border-t border-slate-100 bg-white py-2\">\n      <NuxtLink\n        v-for=\"item in publicNavItems\"\n        :key=\"item.to\"\n        :to=\"item.to\"\n        class=\"flex px-4 py-2.5 text-sm\"\n        :class=\"[\n          isActive(item.to) ? 'text-primary-700 font-medium' : 'text-slate-700',\n        ]\"\n        @click=\"mobileMenuOpen = false\"\n      >\n        {{ item.label }}\n      </NuxtLink>\n      <hr class=\"my-2 border-slate-100\">\n      <div class=\"px-4 pb-2 flex gap-2\">\n        <NuxtLink to=\"/login\" class=\"flex-1 text-center py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-700\">\n          Sign In\n        </NuxtLink>\n        <NuxtLink to=\"/register\" class=\"flex-1 text-center py-2 bg-primary-600 text-white rounded-lg text-sm font-medium\">\n          Join Now\n        </NuxtLink>\n      </div>\n    </div>\n  </header>\n</template>\n","<script setup lang=\"ts\">\nconst { appName, institutionName } = useSiteConfig()\n</script>\n\n<template>\n  <footer class=\"bg-slate-900 text-slate-400 py-12 mt-auto\">\n    <div class=\"max-w-7xl mx-auto px-4\">\n      <div class=\"grid grid-cols-1 md:grid-cols-4 gap-8 mb-8\">\n        <!-- Brand -->\n        <div class=\"md:col-span-2\">\n          <div class=\"flex items-center gap-2 mb-3\">\n            <div class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-primary-600 text-white font-bold text-sm\">\n              A\n            </div>\n            <span class=\"font-bold text-white\">{{ appName }}</span>\n          </div>\n          <p class=\"text-sm text-slate-400 leading-relaxed max-w-xs\">\n            The official alumni network of {{ institutionName }}. Stay connected with your batchmates and contribute to the community.\n          </p>\n        </div>\n\n        <!-- Links -->\n        <div>\n          <h4 class=\"text-white font-semibold text-sm mb-3\">Explore</h4>\n          <ul class=\"space-y-2 text-sm\">\n            <li><NuxtLink to=\"/directory\" class=\"hover:text-white transition-colors\">Alumni Directory</NuxtLink></li>\n            <li><NuxtLink to=\"/events\" class=\"hover:text-white transition-colors\">Events</NuxtLink></li>\n            <li><NuxtLink to=\"/news\" class=\"hover:text-white transition-colors\">News</NuxtLink></li>\n            <li><NuxtLink to=\"/jobs\" class=\"hover:text-white transition-colors\">Job Board</NuxtLink></li>\n          </ul>\n        </div>\n\n        <!-- Account -->\n        <div>\n          <h4 class=\"text-white font-semibold text-sm mb-3\">Account</h4>\n          <ul class=\"space-y-2 text-sm\">\n            <li><NuxtLink to=\"/login\" class=\"hover:text-white transition-colors\">Sign In</NuxtLink></li>\n            <li><NuxtLink to=\"/register\" class=\"hover:text-white transition-colors\">Register</NuxtLink></li>\n            <li><NuxtLink to=\"/feed\" class=\"hover:text-white transition-colors\">Alumni Feed</NuxtLink></li>\n            <li><NuxtLink to=\"/profile\" class=\"hover:text-white transition-colors\">My Profile</NuxtLink></li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"border-t border-slate-800 pt-6 flex flex-col sm:flex-row justify-between items-center gap-2\">\n        <p class=\"text-xs text-slate-500\">\n          &copy; {{ new Date().getFullYear() }} {{ institutionName }}. All rights reserved.\n        </p>\n        <p class=\"text-xs text-slate-600\">\n          Powered by Alumni Portal\n        </p>\n      </div>\n    </div>\n  </footer>\n</template>\n","<script setup lang=\"ts\">\nimport Header from '~/components/layouts/header.vue'\nimport Footer from '~/components/layouts/footer.vue'\n</script>\n\n<template>\n  <div class=\"flex flex-col min-h-screen\">\n    <Header />\n    <main class=\"flex-1\">\n      <slot />\n    </main>\n    <Footer />\n  </div>\n</template>\n"],"version":3}