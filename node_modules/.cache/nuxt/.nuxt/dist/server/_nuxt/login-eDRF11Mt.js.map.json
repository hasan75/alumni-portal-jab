{"file":"login-eDRF11Mt.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AASA,eAAW;AAAA,MACT,OAAO;AAAA,MACP,QAAQ;AAAA,IAAA,CACT;AAEgB,sBAAA;AACjB,UAAM,OAAO,gBAAA;AACb,UAAM,YAAY,aAAA;AAClB,UAAM,EAAE,QAAA,IAAY,cAAA;AAEpB,UAAM,QAAQ,SAAA;AACd,UAAM,aAAa,MAAM,MAAM;AAE/B,UAAM,MAAM,OAAO,YAAY;AAC7B,UAAI,SAAS;AACX,cAAM,UAAU,YAAA;AAChB,YAAI,UAAU,WAAW;AACvB,qBAAW,UAAU;AAAA,QACvB,WACS,UAAU,UAAU;AAC3B,qBAAW,OAAO;AAAA,QACpB;AAAA,MACF;AAAA,IACF,GAAG,EAAE,WAAW,MAAM;AAEtB,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,WAAW,IAAI,EAAE;AACvB,UAAM,UAAU,IAAI,KAAK;AACzB,UAAM,QAAQ,IAAI,eAAe,cAAc,uEAAuE,EAAE;;;AAkCjH,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,qHAAiH,MAAA,CAAA,CAAA,8DAAA;;QAG5G,IAAG;AAAA,QAAI,OAAM;AAAA,MAAA;yBAAvB,CAQW,GAAAC,QAAAC,UAAA,aAAA;;wQAHqCC,MAAA,OAAA,CAAO;;;cAJrDC,YAEM,OAAA,EAFD,OAAM,8GAAA,GAA8G,KAEzH;AAAA,cACAA,YAGM,OAAA,EAHD,OAAM,eAAW;AAAA,gBACpBA,YAA2D,MAAA,EAAvD,OAAM,+BAAA,mBAAkCD,MAAA,OAAA,CAAO,GAAA,CAAA;AAAA,gBACnDC,YAAmD,KAAA,EAAhD,OAAM,yBAAA,GAAyB,eAAa;AAAA,cAAA;;;;;;;UASpCD,MAAA,KAAA,GAAK;;UAAE,UAAS;AAAA,UAAQ,OAAM;AAAA,UAAQ,UAAU;AAAA,QAAA;2BAA/D,CAEU,GAAAF,QAAAC,UAAA,aAAA;;uCADLC,MAAA,KAAA,CAAK,CAAA,EAAA;AAAA;;gDAALA,MAAA,KAAA,CAAK,GAAA,CAAA;AAAA,cAAA;AAAA;;;;;;;;;QAOJ,IAAG;AAAA,oBACMA,MAAA,KAAA;AAAA,0DAAA,MAAK,QAAA,SAAA;AAAA,QACd,MAAK;AAAA,QACL,aAAY;AAAA,QACZ,OAAM;AAAA,QACL,UAAUA,MAAA,OAAA;AAAA,MAAA;;;QAOX,IAAG;AAAA,oBACMA,MAAA,QAAA;AAAA,6DAAA,SAAQ,QAAA,SAAA;AAAA,QACjB,aAAY;AAAA,QACX,UAAU;AAAA,QACX,eAAA;AAAA,QACA,OAAM;AAAA,QACN,eAAY;AAAA,QACX,UAAUA,MAAA,OAAA;AAAA,MAAA;;;QAKb,MAAK;AAAA,QACL,OAAM;AAAA,QACN,MAAK;AAAA,QACL,OAAM;AAAA,QACL,SAASA,MAAA,OAAA;AAAA,MAAA;;;QAMF,IAAG;AAAA,QAAY,OAAM;AAAA,MAAA;yBAA/B,CAEW,GAAAF,QAAAC,UAAA,aAAA;;;;;8BAFwE,iBAEnF;AAAA,YAAA;AAAA;;;;;;QAIU,IAAG;AAAA,QAAI,OAAM;AAAA,MAAA;yBAAvB,CAGW,GAAAD,QAAAC,UAAA,aAAA;;;;;cAFTE,YAAsC,KAAA,EAAnC,OAAM,4BAA0B;AAAA,8BAAG,gBAExC;AAAA,YAAA;AAAA;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_unref","_createVNode"],"sources":["../../../../../../../app/pages/login.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport InputText from 'primevue/inputtext'\nimport Password from 'primevue/password'\nimport Button from 'primevue/button'\nimport Message from 'primevue/message'\nimport { useAuthStore } from '~/stores/auth'\n\ndefinePageMeta({ layout: false })\n\nuseSeoMeta({\n  title: 'Sign In | Alumni Portal',\n  robots: 'noindex, nofollow',\n})\n\nconst supabase = useSupabaseClient()\nconst user = useSupabaseUser()\nconst authStore = useAuthStore()\nconst { appName } = useSiteConfig()\n\nconst route = useRoute()\nconst errorParam = route.query.error\n\nwatch(user, async (newUser) => {\n  if (newUser) {\n    await authStore.loadProfile()\n    if (authStore.isPending) {\n      navigateTo('/pending')\n    }\n    else if (authStore.isActive) {\n      navigateTo('/feed')\n    }\n  }\n}, { immediate: true })\n\nconst email = ref('')\nconst password = ref('')\nconst loading = ref(false)\nconst error = ref(errorParam === 'suspended' ? 'Your account has been suspended. Please contact the administrator.' : '')\n\nasync function handleLogin() {\n  if (!email.value || !password.value) {\n    error.value = 'Please enter your email and password'\n    return\n  }\n\n  loading.value = true\n  error.value = ''\n\n  try {\n    const { error: authError } = await supabase.auth.signInWithPassword({\n      email: email.value,\n      password: password.value,\n    })\n\n    if (authError) {\n      error.value = authError.message.includes('Invalid login credentials')\n        ? 'Invalid email or password'\n        : authError.message\n      return\n    }\n  }\n  catch (e: any) {\n    error.value = e.message || 'Login failed'\n  }\n  finally {\n    loading.value = false\n  }\n}\n</script>\n\n<template>\n  <div class=\"min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 via-slate-800 to-primary-900 p-4\">\n    <div class=\"w-full max-w-md\">\n      <div class=\"text-center mb-8\">\n        <NuxtLink to=\"/\" class=\"inline-flex items-center gap-3\">\n          <div class=\"flex h-12 w-12 items-center justify-center rounded-xl bg-primary-500 text-white text-xl font-bold shadow-lg\">\n            A\n          </div>\n          <div class=\"text-left\">\n            <h1 class=\"text-xl font-bold text-white\">{{ appName }}</h1>\n            <p class=\"text-sm text-slate-400\">Alumni Portal</p>\n          </div>\n        </NuxtLink>\n      </div>\n\n      <div class=\"bg-white rounded-2xl shadow-2xl p-8\">\n        <h2 class=\"text-2xl font-bold text-slate-900 text-center mb-2\">Welcome Back</h2>\n        <p class=\"text-slate-500 text-center mb-6\">Sign in to your alumni account</p>\n\n        <Message v-if=\"error\" severity=\"error\" class=\"mb-4\" :closable=\"false\">\n          {{ error }}\n        </Message>\n\n        <form class=\"space-y-5\" @submit.prevent=\"handleLogin\">\n          <div>\n            <label for=\"email\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">Email</label>\n            <InputText\n              id=\"email\"\n              v-model=\"email\"\n              type=\"email\"\n              placeholder=\"you@example.com\"\n              class=\"w-full\"\n              :disabled=\"loading\"\n            />\n          </div>\n\n          <div>\n            <label for=\"password\" class=\"block text-sm font-medium text-slate-700 mb-1.5\">Password</label>\n            <Password\n              id=\"password\"\n              v-model=\"password\"\n              placeholder=\"Your password\"\n              :feedback=\"false\"\n              toggle-mask\n              class=\"w-full\"\n              input-class=\"w-full\"\n              :disabled=\"loading\"\n            />\n          </div>\n\n          <Button\n            type=\"submit\"\n            label=\"Sign In\"\n            icon=\"pi pi-sign-in\"\n            class=\"w-full\"\n            :loading=\"loading\"\n          />\n        </form>\n\n        <div class=\"mt-5 text-center text-sm text-slate-500\">\n          Don't have an account?\n          <NuxtLink to=\"/register\" class=\"text-primary-600 font-medium hover:underline ml-1\">\n            Register here\n          </NuxtLink>\n        </div>\n\n        <div class=\"mt-6 text-center\">\n          <NuxtLink to=\"/\" class=\"text-sm text-slate-400 hover:text-primary-600 transition-colors inline-flex items-center gap-1\">\n            <i class=\"pi pi-arrow-left text-xs\" />\n            Back to site\n          </NuxtLink>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n"],"version":3}