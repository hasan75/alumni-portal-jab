{"file":"index-BqLmQkU7.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;AAKA,eAAW,EAAE,OAAO,eAAe,QAAQ,WAAW;AAEtD,UAAM,EAAE,YAAY,OAAO,SAAS,QAAA,IAAY,QAAA;AAEhD,KAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM,WAAW,SAAS,CAAA;AAO1B,aAAS,cAAc,IAAY;AACjC,YAAM,MAAM,MAAM,MAAM,UAAU,CAAA,MAAK,EAAE,OAAO,EAAE;AAClD,UAAI,QAAQ,GAAI,OAAM,MAAM,OAAO,KAAK,CAAC;AAAA,IAC3C;;AAIO,YAAA,OAAAC,eAAAC,WAAA,EAAA,OAAM,gCAA4B,MAAA,CAAA,CAAA,GAAA;;QACvB,OAAM;AAAA,QAAW,sBAAQC,MAAA,UAAA,EAAU,SAAA;AAAA,MAAA;UAEtCA,MAAA,OAAA,GAAO;;AACCC,sBAAA,IAAL,MAAC;;;;;;AAKIA,sBAAAD,MAAA,KAAA,IAAR,SAAI;;YACV,KAAK,KAAK;AAAA,YACV;AAAA,YACA,WAAS;AAAA,UAAA;;;;UAIHA,MAAA,OAAA,KAAWA,MAAA,KAAA,EAAM,SAAM,GAAA;;;;;WAStBA,MAAA,OAAA,KAAWA,MAAA,KAAA,EAAM,WAAM,GAAA;;;;;;;;;;;;;;;","names":["_withAsyncContext","_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderList"],"sources":["../../../../../../../app/pages/feed/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport PostComposer from '~/components/feed/PostComposer.vue'\nimport FeedPost from '~/components/feed/FeedPost.vue'\n\ndefinePageMeta({ layout: 'member', middleware: 'member-auth' })\nuseSeoMeta({ title: 'Alumni Feed', robots: 'noindex' })\n\nconst { fetchPosts, posts, loading, hasMore } = useFeed()\n\nawait fetchPosts('general')\n\nasync function loadMore() {\n  const nextPage = Math.ceil(posts.value.length / 10) + 1\n  await fetchPosts('general', undefined, nextPage)\n}\n\nfunction onPostRemoved(id: number) {\n  const idx = posts.value.findIndex(p => p.id === id)\n  if (idx !== -1) posts.value.splice(idx, 1)\n}\n</script>\n\n<template>\n  <div class=\"max-w-xl mx-auto space-y-4\">\n    <PostComposer scope=\"general\" @posted=\"fetchPosts('general')\" />\n\n    <div v-if=\"loading\" class=\"space-y-4\">\n      <div v-for=\"i in 3\" :key=\"i\" class=\"bg-white border border-slate-200 rounded-xl h-40 animate-pulse\" />\n    </div>\n\n    <template v-else>\n      <FeedPost\n        v-for=\"post in posts\"\n        :key=\"post.id\"\n        :post=\"post\"\n        @removed=\"onPostRemoved\"\n      />\n    </template>\n\n    <div v-if=\"hasMore && posts.length > 0\" class=\"text-center\">\n      <button\n        class=\"px-6 py-2 text-sm font-medium text-primary-600 hover:bg-primary-50 rounded-lg transition-colors\"\n        @click=\"loadMore\"\n      >\n        Load more\n      </button>\n    </div>\n\n    <div v-if=\"!loading && posts.length === 0\" class=\"text-center py-16\">\n      <i class=\"pi pi-comments text-4xl text-slate-300 mb-3 block\" />\n      <p class=\"text-slate-500\">No posts yet. Be the first to share something!</p>\n    </div>\n  </div>\n</template>\n"],"version":3}