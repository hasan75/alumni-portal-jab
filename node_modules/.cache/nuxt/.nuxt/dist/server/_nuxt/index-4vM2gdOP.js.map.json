AAO;AAAA,cAAA;cAClCT,YASSC,MAAAQ,QAAA,GAAA,EATD,QAAO,aAAS;AAAA,gBACX,MAAIC,QACb,CAKM,EANW,WAAI;AAAA,kBACrBV,YAKM,OAAA,EALD,OAAM,gBAAY;AAAA,oBACrBA,YAEW,qBAAA;AAAA,sBAFA,IAAE,iBAAmB,KAAK,EAAE;AAAA,oBAAA;uCACrC,MAAgD;AAAA,wBAAhDA,YAAgDC,MAAAC,MAAA,GAAA;AAAA,0BAAxC,MAAK;AAAA,0BAAe,MAAK;AAAA,0BAAQ,MAAA;AAAA,wBAAA;;;;oBAE3CF,YAA4GC,MAAAC,MAAA,GAAA;AAAA,sBAApG,MAAK;AAAA,sBAAc,MAAK;AAAA,sBAAQ,MAAA;AAAA,sBAAK,UAAS;AAAA,sBAAU,SAAK,CAAA,WAAE,aAAa,KAAK,IAAI,KAAK,KAAK;AAAA,oBAAA;;;;;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrRenderComponent","_push","_parent","_createVNode","_unref","Button","_scopeId","_","_ssrInterpolate","_createTextVNode","_toDisplayString","Tag","Column","_withCtx"],"sources":["../../../../../../../app/pages/admin/events/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport DataTable from 'primevue/datatable'\nimport Column from 'primevue/column'\nimport Button from 'primevue/button'\nimport InputText from 'primevue/inputtext'\nimport Tag from 'primevue/tag'\nimport { formatDateShort } from '~/utils/formatters'\n\ndefinePageMeta({ layout: 'admin', middleware: 'admin-auth' })\nuseSeoMeta({ title: 'Events | Admin', robots: 'noindex' })\n\nconst { fetchAllForAdmin, deleteEvent } = useEvents()\nconst toast = useToast()\nconst confirm = useConfirm()\n\nconst events = ref<any[]>([])\nconst loading = ref(false)\nconst search = ref('')\n\nasync function load() {\n  loading.value = true\n  events.value = await fetchAllForAdmin({ search: search.value || undefined })\n  loading.value = false\n}\n\nonMounted(load)\n\nconst debounce = ref<ReturnType<typeof setTimeout>>()\nfunction onSearch() {\n  clearTimeout(debounce.value)\n  debounce.value = setTimeout(load, 300)\n}\n\nfunction handleDelete(id: number, title: string) {\n  confirm.require({\n    message: `Delete \"${title}\"?`,\n    header: 'Confirm Delete',\n    icon: 'pi pi-trash',\n    rejectClass: 'p-button-secondary',\n    accept: async () => {\n      const result = await deleteEvent(id)\n      if (result.success) {\n        toast.add({ severity: 'success', summary: 'Event deleted', life: 2000 })\n        await load()\n      }\n    },\n  })\n}\n\nconst statusSeverity: Record<string, string> = {\n  published: 'success',\n  draft: 'secondary',\n  cancelled: 'danger',\n  completed: 'info',\n}\n</script>\n\n<template>\n  <div class=\"space-y-4\">\n    <div class=\"flex items-center justify-between flex-wrap gap-3\">\n      <h1 class=\"text-xl font-bold text-slate-900\">Events</h1>\n      <NuxtLink to=\"/admin/events/new\">\n        <Button label=\"New Event\" icon=\"pi pi-plus\" size=\"small\" />\n      </NuxtLink>\n    </div>\n\n    <div class=\"flex gap-3\">\n      <InputText v-model=\"search\" placeholder=\"Search events...\" class=\"flex-1 max-w-sm\" @input=\"onSearch\" />\n    </div>\n\n    <div class=\"bg-white border border-slate-200 rounded-xl overflow-hidden\">\n      <DataTable :value=\"events\" :loading=\"loading\" data-key=\"id\" class=\"text-sm\">\n        <Column field=\"title\" header=\"Title\">\n          <template #body=\"{ data }\">\n            <NuxtLink :to=\"`/admin/events/${data.id}`\" class=\"font-medium text-slate-900 hover:text-primary-600\">\n              {{ data.title }}\n            </NuxtLink>\n          </template>\n        </Column>\n        <Column field=\"event_type\" header=\"Type\" />\n        <Column field=\"start_datetime\" header=\"Date\">\n          <template #body=\"{ data }\">\n            {{ formatDateShort(data.start_datetime) }}\n          </template>\n        </Column>\n        <Column field=\"status\" header=\"Status\">\n          <template #body=\"{ data }\">\n            <Tag :value=\"data.status\" :severity=\"statusSeverity[data.status] || 'secondary'\" />\n          </template>\n        </Column>\n        <Column field=\"rsvp_count\" header=\"RSVPs\" />\n        <Column header=\"Actions\">\n          <template #body=\"{ data }\">\n            <div class=\"flex gap-1\">\n              <NuxtLink :to=\"`/admin/events/${data.id}`\">\n                <Button icon=\"pi pi-pencil\" size=\"small\" text />\n              </NuxtLink>\n              <Button icon=\"pi pi-trash\" size=\"small\" text severity=\"danger\" @click=\"handleDelete(data.id, data.title)\" />\n            </div>\n          </template>\n        </Column>\n      </DataTable>\n    </div>\n  </div>\n</template>\n"],"version":3}