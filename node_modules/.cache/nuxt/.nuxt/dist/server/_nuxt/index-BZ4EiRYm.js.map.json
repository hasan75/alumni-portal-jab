d from '~/components/news/ArticleCard.vue'\nimport EventCard from '~/components/events/EventCard.vue'\nimport JobCard from '~/components/jobs/JobCard.vue'\n\nuseSeoMeta({\n  title: 'Alumni Portal — Stay Connected',\n  description: 'The official alumni network. Connect with batchmates, discover events, news, and opportunities.',\n})\n\nconst { fetchArticles } = useNews()\nconst { fetchEvents } = useEvents()\nconst { fetchJobs } = useJobs()\nconst { appName, institutionName, tagline } = useSiteConfig()\n\nconst { data: articles } = await useAsyncData('home-articles', () =>\n  fetchArticles({ perPage: 3, featured: true }),\n)\n\nconst { data: events } = await useAsyncData('home-events', () =>\n  fetchEvents({ upcoming: true, perPage: 3 }),\n)\n\nconst { data: jobs } = await useAsyncData('home-jobs', () =>\n  fetchJobs({ perPage: 4, featured: true }),\n)\n</script>\n\n<template>\n  <div>\n    <!-- Hero -->\n    <section class=\"bg-gradient-to-br from-primary-700 via-primary-600 to-primary-800 text-white py-20 px-4\">\n      <div class=\"max-w-4xl mx-auto text-center\">\n        <h1 class=\"text-4xl md:text-5xl font-bold mb-4 leading-tight\">\n          Welcome to {{ appName }}\n        </h1>\n        <p class=\"text-xl text-primary-100 mb-8 max-w-2xl mx-auto\">\n          {{ tagline }}\n        </p>\n        <div class=\"flex flex-col sm:flex-row gap-3 justify-center\">\n          <NuxtLink\n            to=\"/register\"\n            class=\"px-6 py-3 bg-white text-primary-700 font-semibold rounded-xl hover:bg-primary-50 transition-colors\"\n          >\n            Join the Network\n          </NuxtLink>\n          <NuxtLink\n            to=\"/directory\"\n            class=\"px-6 py-3 border border-primary-300 text-white font-semibold rounded-xl hover:bg-primary-600 transition-colors\"\n          >\n            Browse Alumni\n          </NuxtLink>\n        </div>\n      </div>\n    </section>\n\n    <!-- Stats -->\n    <section class=\"bg-white border-b border-slate-200 py-10 px-4\">\n      <div class=\"max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 text-center\">\n        <div>\n          <p class=\"text-3xl font-bold text-primary-600\">500+</p>\n          <p class=\"text-slate-500 text-sm mt-1\">Active Alumni</p>\n        </div>\n        <div>\n          <p class=\"text-3xl font-bold text-primary-600\">20+</p>\n          <p class=\"text-slate-500 text-sm mt-1\">Batches</p>\n        </div>\n        <div>\n          <p class=\"text-3xl font-bold text-primary-600\">50+</p>\n          <p class=\"text-slate-500 text-sm mt-1\">Countries</p>\n        </div>\n        <div>\n          <p class=\"text-3xl font-bold text-primary-600\">100+</p>\n          <p class=\"text-slate-500 text-sm mt-1\">Events Hosted</p>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"max-w-6xl mx-auto px-4 py-12 space-y-16\">\n      <!-- Upcoming Events -->\n      <section v-if=\"events && events.length > 0\">\n        <div class=\"flex items-center justify-between mb-6\">\n          <h2 class=\"text-2xl font-bold text-slate-900\">Upcoming Events</h2>\n          <NuxtLink to=\"/events\" class=\"text-primary-600 hover:underline text-sm font-medium\">\n            View all →\n          </NuxtLink>\n        </div>\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n          <EventCard v-for=\"event in events\" :key=\"event.id\" :event=\"event\" />\n        </div>\n      </section>\n\n      <!-- Latest News -->\n      <section v-if=\"articles && articles.length > 0\">\n        <div class=\"flex items-center justify-between mb-6\">\n          <h2 class=\"text-2xl font-bold text-slate-900\">Latest News</h2>\n          <NuxtLink to=\"/news\" class=\"text-primary-600 hover:underline text-sm font-medium\">\n            View all →\n          </NuxtLink>\n        </div>\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n          <ArticleCard v-for=\"article in articles\" :key=\"article.id\" :article=\"article\" />\n        </div>\n      </section>\n\n      <!-- Job Spotlight -->\n      <section v-if=\"jobs && jobs.length > 0\">\n        <div class=\"flex items-center justify-between mb-6\">\n          <h2 class=\"text-2xl font-bold text-slate-900\">Job Opportunities</h2>\n          <NuxtLink to=\"/jobs\" class=\"text-primary-600 hover:underline text-sm font-medium\">\n            View all →\n          </NuxtLink>\n        </div>\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n          <JobCard v-for=\"job in jobs\" :key=\"job.id\" :job=\"job\" />\n        </div>\n      </section>\n\n      <!-- CTA -->\n      <section class=\"bg-primary-50 rounded-2xl p-8 text-center\">\n        <h2 class=\"text-2xl font-bold text-slate-900 mb-2\">Are you an alumnus of {{ institutionName }}?</h2>\n        <p class=\"text-slate-600 mb-6\">Join the community to connect with your batchmates, RSVP to events, and more.</p>\n        <NuxtLink\n          to=\"/register\"\n          class=\"inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white font-semibold rounded-xl hover:bg-primary-700 transition-colors\"\n        >\n          <i class=\"pi pi-user-plus\" />\n          Register Now\n        </NuxtLink>\n      </section>\n    </div>\n  </div>\n</template>\n"],"version":3}