;AAAA;;;;SAKd,CALM,SAAI;;UAMV,KAAK,KAAK;AAAA,UACV,IAAI,KAAK;AAAA,UACV,OAAK,CAAC,iGACE,KAAK,MAAM,QAAO,SAAA,eAAA,EAA2B,QAAO,OAAA,KAAA,CAAA;AAAA,QAAA;2BAV9D,CAgBW,GAAAC,QAAAC,UAAA,aAAA;;oCAJgEC,eAAA,CAAA,KAAK,OAAK,qDAAA,CAAA,2BACtEA,eAAA,KAAK,IAAI,+EAEsBC,eAAA,KAAK,KAAK;;;gBAHtDC,YAEM,OAAA;AAAA,kBAFD,OAAK,CAAC,uDAA8D,KAAK,KAAK;AAAA,gBAAA;kBACjFA,YAAwB,KAAA;AAAA,oBAApB,OAAO,KAAK;AAAA,kBAAA;;gBAElBA,YAAgE,UAA1D,OAAM,6BAAA,GAA4BC,gBAAI,KAAK,KAAK,GAAA,CAAA;AAAA,cAAA;AAAA;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderList","_push","_parent","_ssrRenderClass","_ssrInterpolate","_createVNode","_toDisplayString"],"sources":["../../../../../../../app/pages/admin/dashboard.vue"],"sourcesContent":["<script setup lang=\"ts\">\ndefinePageMeta({ layout: 'admin', middleware: 'admin-auth' })\nuseSeoMeta({ title: 'Dashboard | Admin', robots: 'noindex' })\n\nconst supabase = useSupabaseClient()\nconst { appName } = useSiteConfig()\n\nconst stats = ref({\n  pendingMembers: 0,\n  activeMembers: 0,\n  upcomingEvents: 0,\n  publishedArticles: 0,\n  openJobs: 0,\n  recentPosts: 0,\n})\n\nconst recentPendingMembers = ref<any[]>([])\n\nonMounted(async () => {\n  const [pending, active, events, articles, jobs, posts, recentPending] = await Promise.all([\n    supabase.from('alumni_profiles').select('id', { count: 'exact', head: true }).eq('status', 'pending'),\n    supabase.from('alumni_profiles').select('id', { count: 'exact', head: true }).eq('status', 'active'),\n    supabase.from('events').select('id', { count: 'exact', head: true }).eq('status', 'published').gte('start_datetime', new Date().toISOString()),\n    supabase.from('articles').select('id', { count: 'exact', head: true }).eq('status', 'published'),\n    supabase.from('jobs').select('id', { count: 'exact', head: true }).eq('status', 'published'),\n    supabase.from('feed_posts').select('id', { count: 'exact', head: true }).eq('status', 'published').gte('created_at', new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString()),\n    supabase.from('alumni_profiles').select('id, full_name, email, batch_year, created_at').eq('status', 'pending').order('created_at', { ascending: false }).limit(5),\n  ])\n\n  stats.value = {\n    pendingMembers: pending.count || 0,\n    activeMembers: active.count || 0,\n    upcomingEvents: events.count || 0,\n    publishedArticles: articles.count || 0,\n    openJobs: jobs.count || 0,\n    recentPosts: posts.count || 0,\n  }\n\n  recentPendingMembers.value = recentPending.data || []\n})\n\nconst statCards = computed(() => [\n  { label: 'Pending Approvals', value: stats.value.pendingMembers, icon: 'pi pi-clock', color: 'text-amber-600 bg-amber-50', to: '/admin/members?status=pending', urgent: stats.value.pendingMembers > 0 },\n  { label: 'Active Members', value: stats.value.activeMembers, icon: 'pi pi-users', color: 'text-green-600 bg-green-50', to: '/admin/members' },\n  { label: 'Upcoming Events', value: stats.value.upcomingEvents, icon: 'pi pi-calendar', color: 'text-blue-600 bg-blue-50', to: '/admin/events' },\n  { label: 'Published Articles', value: stats.value.publishedArticles, icon: 'pi pi-megaphone', color: 'text-purple-600 bg-purple-50', to: '/admin/news' },\n  { label: 'Open Jobs', value: stats.value.openJobs, icon: 'pi pi-briefcase', color: 'text-orange-600 bg-orange-50', to: '/admin/jobs' },\n  { label: 'Posts This Week', value: stats.value.recentPosts, icon: 'pi pi-comments', color: 'text-sky-600 bg-sky-50', to: '/admin/feed' },\n])\n</script>\n\n<template>\n  <div class=\"space-y-6\">\n    <div>\n      <h1 class=\"text-2xl font-bold text-slate-900\">Dashboard</h1>\n      <p class=\"text-slate-500 text-sm\">Welcome to {{ appName }} Admin Panel</p>\n    </div>\n\n    <!-- Stats Grid -->\n    <div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4\">\n      <NuxtLink\n        v-for=\"card in statCards\"\n        :key=\"card.label\"\n        :to=\"card.to\"\n        class=\"bg-white border rounded-xl p-4 hover:shadow-sm transition-all\"\n        :class=\"card.urgent ? 'border-amber-200' : 'border-slate-200'\"\n      >\n        <div class=\"flex items-center gap-2 mb-2\">\n          <div class=\"w-8 h-8 rounded-lg flex items-center justify-center\" :class=\"card.color\">\n            <i :class=\"card.icon\" class=\"text-sm\" />\n          </div>\n        </div>\n        <p class=\"text-2xl font-bold text-slate-900\">{{ card.value }}</p>\n        <p class=\"text-xs text-slate-500 mt-0.5\">{{ card.label }}</p>\n      </NuxtLink>\n    </div>\n\n    <!-- Pending Members -->\n    <div v-if=\"recentPendingMembers.length > 0\" class=\"bg-white border border-amber-200 rounded-xl p-5\">\n      <div class=\"flex items-center justify-between mb-4\">\n        <h2 class=\"font-semibold text-slate-900 flex items-center gap-2\">\n          <i class=\"pi pi-clock text-amber-500\" />\n          Pending Approvals\n        </h2>\n        <NuxtLink to=\"/admin/members?status=pending\" class=\"text-sm text-primary-600 hover:underline\">\n          View all →\n        </NuxtLink>\n      </div>\n      <div class=\"space-y-2\">\n        <div\n          v-for=\"member in recentPendingMembers\"\n          :key=\"member.id\"\n          class=\"flex items-center justify-between py-2 border-b border-slate-100 last:border-0\"\n        >\n          <div>\n            <p class=\"text-sm font-medium text-slate-800\">{{ member.full_name }}</p>\n            <p class=\"text-xs text-slate-500\">{{ member.email }}<span v-if=\"member.batch_year\"> · Class of {{ member.batch_year }}</span></p>\n          </div>\n          <NuxtLink\n            :to=\"`/admin/members/${member.id}`\"\n            class=\"text-xs text-primary-600 hover:underline\"\n          >\n            Review\n          </NuxtLink>\n        </div>\n      </div>\n    </div>\n\n    <!-- Quick links -->\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n      <NuxtLink\n        v-for=\"link in [\n          { label: 'Add Event', icon: 'pi pi-calendar-plus', to: '/admin/events/new', color: 'bg-blue-50 text-blue-700' },\n          { label: 'Write Article', icon: 'pi pi-file-edit', to: '/admin/news/new', color: 'bg-purple-50 text-purple-700' },\n          { label: 'Post Job', icon: 'pi pi-briefcase', to: '/admin/jobs/new', color: 'bg-orange-50 text-orange-700' },\n          { label: 'App Settings', icon: 'pi pi-cog', to: '/admin/settings', color: 'bg-slate-50 text-slate-700' },\n        ]\"\n        :key=\"link.to\"\n        :to=\"link.to\"\n        class=\"flex items-center gap-3 p-4 border border-slate-200 rounded-xl hover:shadow-sm transition-all\"\n        :class=\"link.color.replace('text-', 'hover:border-').replace('700', '300')\"\n      >\n        <div class=\"w-9 h-9 rounded-lg flex items-center justify-center\" :class=\"link.color\">\n          <i :class=\"link.icon\" />\n        </div>\n        <span class=\"font-medium text-slate-800\">{{ link.label }}</span>\n      </NuxtLink>\n    </div>\n  </div>\n</template>\n"],"version":3}