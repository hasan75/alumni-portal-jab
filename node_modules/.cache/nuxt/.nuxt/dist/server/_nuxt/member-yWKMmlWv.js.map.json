AAK;AAAA,kBAAA;kCAAQ,MACxBI,gBAAG,KAAK,KAAK,GAAA,CAAA;AAAA,gBAAA;AAAA;;;;;;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_unref","_createVNode","_ssrRenderList","_ssrRenderClass","_ssrInterpolate","_toDisplayString","_ssrRenderAttr","_createBlock"],"sources":["../../../../../../../app/layouts/member.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport { useAuthStore } from '~/stores/auth'\n\nconst authStore = useAuthStore()\nconst supabase = useSupabaseClient()\nconst route = useRoute()\n\nconst { appName } = useSiteConfig()\n\nconst mobileMenuOpen = ref(false)\n\nconst navItems = [\n  { label: 'Feed', icon: 'pi pi-home', to: '/feed' },\n  { label: 'Directory', icon: 'pi pi-users', to: '/directory' },\n  { label: 'Events', icon: 'pi pi-calendar', to: '/events' },\n  { label: 'News', icon: 'pi pi-megaphone', to: '/news' },\n  { label: 'Jobs', icon: 'pi pi-briefcase', to: '/jobs' },\n]\n\nfunction isActive(path: string) {\n  return route.path === path || route.path.startsWith(`${path}/`)\n}\n\nasync function handleSignOut() {\n  authStore.clear()\n  await supabase.auth.signOut()\n  navigateTo('/')\n}\n\nonMounted(() => {\n  if (!authStore.isLoaded) {\n    authStore.loadProfile()\n  }\n})\n</script>\n\n<template>\n  <div class=\"min-h-screen bg-slate-50\">\n    <!-- Top nav -->\n    <header class=\"bg-white border-b border-slate-200 sticky top-0 z-30\">\n      <div class=\"max-w-7xl mx-auto px-4 h-14 flex items-center justify-between gap-4\">\n        <!-- Logo -->\n        <NuxtLink to=\"/feed\" class=\"flex items-center gap-2 shrink-0\">\n          <div class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-primary-600 text-white font-bold text-sm\">\n            A\n          </div>\n          <span class=\"font-semibold text-slate-900 hidden sm:inline\">{{ appName }}</span>\n        </NuxtLink>\n\n        <!-- Desktop nav -->\n        <nav class=\"hidden md:flex items-center gap-1\">\n          <NuxtLink\n            v-for=\"item in navItems\"\n            :key=\"item.to\"\n            :to=\"item.to\"\n            class=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition-colors\"\n            :class=\"[\n              isActive(item.to)\n                ? 'bg-primary-50 text-primary-700'\n                : 'text-slate-600 hover:bg-slate-50',\n            ]\"\n          >\n            <i :class=\"item.icon\" class=\"text-sm\" />\n            <span>{{ item.label }}</span>\n          </NuxtLink>\n        </nav>\n\n        <!-- Right: profile -->\n        <div class=\"flex items-center gap-2\">\n          <NuxtLink\n            to=\"/profile\"\n            class=\"flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm text-slate-600 hover:bg-slate-50 transition-colors\"\n          >\n            <img\n              v-if=\"authStore.profile?.avatar_url\"\n              :src=\"authStore.profile.avatar_url\"\n              class=\"w-7 h-7 rounded-full object-cover\"\n              alt=\"Avatar\"\n            >\n            <div\n              v-else\n              class=\"flex h-7 w-7 items-center justify-center rounded-full bg-primary-100 text-primary-700 font-medium text-xs\"\n            >\n              {{ authStore.displayName.charAt(0).toUpperCase() }}\n            </div>\n            <span class=\"hidden sm:inline\">{{ authStore.displayName }}</span>\n          </NuxtLink>\n          <button\n            class=\"hidden md:flex items-center gap-1 px-2 py-1.5 rounded-lg text-sm text-slate-500 hover:bg-slate-50 transition-colors\"\n            @click=\"handleSignOut\"\n          >\n            <i class=\"pi pi-sign-out\" />\n          </button>\n          <button\n            class=\"md:hidden p-1.5 rounded-lg text-slate-600 hover:bg-slate-50\"\n            @click=\"mobileMenuOpen = !mobileMenuOpen\"\n          >\n            <i class=\"pi pi-bars\" />\n          </button>\n        </div>\n      </div>\n\n      <!-- Mobile menu -->\n      <div v-if=\"mobileMenuOpen\" class=\"md:hidden border-t border-slate-100 bg-white py-2\">\n        <NuxtLink\n          v-for=\"item in navItems\"\n          :key=\"item.to\"\n          :to=\"item.to\"\n          class=\"flex items-center gap-3 px-4 py-2.5 text-sm\"\n          :class=\"[\n            isActive(item.to)\n              ? 'text-primary-700 font-medium'\n              : 'text-slate-700',\n          ]\"\n          @click=\"mobileMenuOpen = false\"\n        >\n          <i :class=\"item.icon\" />\n          {{ item.label }}\n        </NuxtLink>\n        <hr class=\"my-2 border-slate-100\">\n        <button\n          class=\"flex items-center gap-3 px-4 py-2.5 text-sm text-slate-600 w-full text-left\"\n          @click=\"handleSignOut\"\n        >\n          <i class=\"pi pi-sign-out\" />\n          Sign Out\n        </button>\n      </div>\n    </header>\n\n    <main class=\"max-w-7xl mx-auto px-4 py-6\">\n      <slot />\n    </main>\n  </div>\n</template>\n"],"version":3}