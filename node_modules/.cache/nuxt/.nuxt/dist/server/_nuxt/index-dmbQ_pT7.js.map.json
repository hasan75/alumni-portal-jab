,SAAS,IAAI,EAAE;AACrB,UAAM,gBAAgB,IAAmB,IAAI;AAC7C,UAAM,cAAc,IAAI,CAAC;AAEzB,UAAM,UAAU,IAAwC,EAAE;AAC1D,UAAM,EAAE,MAAM,UAAA,KAAc,CAAA,QAAA,SAAA,IAAAE,iBAAA,MAAM,aAAa,WAAW,YAAY,CAAA;AACtE,QAAI,UAAU,OAAO;AACnB,cAAQ,QAAQ;AAAA,QACd,EAAE,OAAO,eAAe,OAAO,EAAA;AAAA,QAC/B,GAAG,UAAU,MAAM,IAAI,CAAA,OAAM,EAAE,OAAO,EAAE,SAAS,YAAY,EAAE,IAAI,IAAI,OAAO,EAAE,OAAO;AAAA,MAAA;AAAA,IAE3F;AAEA,UAAM,EAAE,MAAM,SAAS,SAAS,QAAA,KAAY,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM;AAAA,MAAa;AAAA,MAAa,MAC1E,eAAe;AAAA,QACb,QAAQ,OAAO;AAAA,QACf,WAAW,cAAc,SAAS;AAAA,QAClC,MAAM,YAAY;AAAA,MAAA,CACnB;AAAA,IAAA,CACH;AAEA,UAAM,kBAAkB,IAAA;AACxB,aAAS,WAAW;AAClB,mBAAa,gBAAgB,KAAK;AAClC,sBAAgB,QAAQ,WAAW,MAAM;AACvC,oBAAY,QAAQ;AACpB,gBAAA;AAAA,MACF,GAAG,GAAG;AAAA,IACR;AAEA,UAAM,eAAe,MAAM;AACzB,kBAAY,QAAQ;AACpB,cAAA;AAAA,IACF,CAAC;;;+PASYC,MAAA,IAAA,IAAI,6BAAA,qDAAA;;oBAMMA,MAAA,MAAA;AAAA,2DAAA,OAAM,QAAA,SAAA;AAAA,QACf,aAAY;AAAA,QACZ,OAAM;AAAA,QACL,SAAO;AAAA,MAAA;;;oBAIDA,MAAA,aAAA;AAAA,kEAAA,cAAa,QAAA,SAAA;AAAA,QACrB,SAASA,MAAA,OAAA;AAAA,QACV,gBAAa;AAAA,QACb,gBAAa;AAAA,QACb,aAAY;AAAA,QACZ,OAAM;AAAA,MAAA;;UAODA,MAAA,OAAA,GAAO;;AACCC,sBAAA,IAAL,MAAC;;;;iBAWCD,MAAA,OAAA,KAAWA,MAAA,OAAA,EAAQ,SAAM,GAAA;;AACVC,sBAAAD,MAAA,OAAA,IAAV,WAAM;;YAAc,KAAK,OAAO;AAAA,YAAK;AAAA,UAAA;;;;;;WAS9CA,MAAA,IAAA,GAAI;;;UAIF,IAAG;AAAA,UAAS,OAAM;AAAA,QAAA;2BAA5B,CAAgI,GAAAR,QAAAC,UAAA,aAAA;;;;;gCAAlB,SAAO;AAAA,cAAA;AAAA;;;;;UAC3G,IAAG;AAAA,UAAY,OAAM;AAAA,QAAA;2BAA/B,CAAuH,GAAAD,QAAAC,UAAA,aAAA;;;;;gCAAnB,UAAQ;AAAA,cAAA;AAAA;;;;;;;;;;;;;;;;;;","names":["_push","_parent","_ssrInterpolate","_createVNode","_createBlock","_toDisplayString","_createTextVNode","_withAsyncContext","_unref","_ssrRenderList"],"sources":["../../../../../../../app/components/member/MemberCard.vue","../../../../../../../app/pages/directory/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { AlumniProfile } from '~/types/member'\n\ndefineProps<{\n  member: AlumniProfile\n  compact?: boolean\n}>()\n</script>\n\n<template>\n  <NuxtLink\n    :to=\"`/directory/${member.id}`\"\n    class=\"bg-white border border-slate-200 rounded-xl p-4 hover:border-primary-200 hover:shadow-sm transition-all block\"\n  >\n    <div class=\"flex items-start gap-3\">\n      <!-- Avatar -->\n      <div class=\"shrink-0\">\n        <img\n          v-if=\"member.avatar_url\"\n          :src=\"member.avatar_url\"\n          :alt=\"member.full_name\"\n          class=\"w-12 h-12 rounded-full object-cover\"\n        >\n        <div\n          v-else\n          class=\"w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 font-bold text-lg\"\n        >\n          {{ (member.display_name || member.full_name).charAt(0).toUpperCase() }}\n        </div>\n      </div>\n\n      <!-- Info -->\n      <div class=\"flex-1 min-w-0\">\n        <div class=\"flex items-center gap-1.5\">\n          <h3 class=\"font-semibold text-slate-900 text-sm truncate\">\n            {{ member.display_name || member.full_name }}\n          </h3>\n          <i v-if=\"member.is_verified\" class=\"pi pi-verified text-primary-500 text-xs shrink-0\" title=\"Verified\" />\n        </div>\n\n        <p v-if=\"member.current_job_title\" class=\"text-xs text-slate-600 mt-0.5 truncate\">\n          {{ member.current_job_title }}\n          <span v-if=\"member.current_company\" class=\"text-slate-400\"> · {{ member.current_company }}</span>\n        </p>\n\n        <div class=\"flex items-center gap-2 mt-1.5 flex-wrap\">\n          <span\n            v-if=\"member.batch_year\"\n            class=\"inline-flex items-center text-[11px] text-primary-700 bg-primary-50 px-2 py-0.5 rounded-full font-medium\"\n          >\n            Class of {{ member.batch_year }}\n          </span>\n          <span\n            v-if=\"member.city || member.country\"\n            class=\"inline-flex items-center gap-0.5 text-[11px] text-slate-500\"\n          >\n            <i class=\"pi pi-map-marker text-[9px]\" />\n            {{ [member.city, member.country].filter(Boolean).join(', ') }}\n          </span>\n        </div>\n      </div>\n    </div>\n  </NuxtLink>\n</template>\n","<script setup lang=\"ts\">\nimport InputText from 'primevue/inputtext'\nimport Select from 'primevue/select'\nimport MemberCard from '~/components/member/MemberCard.vue'\n\nuseSeoMeta({ title: 'Alumni Directory', description: 'Browse and connect with alumni.' })\n\nconst { fetchDirectory, fetchBatches } = useMembers()\nconst user = useSupabaseUser()\n\nconst search = ref('')\nconst selectedBatch = ref<number | null>(null)\nconst currentPage = ref(1)\n\nconst batches = ref<{ label: string, value: number }[]>([])\nconst { data: batchList } = await useAsyncData('batches', fetchBatches)\nif (batchList.value) {\n  batches.value = [\n    { label: 'All Batches', value: 0 },\n    ...batchList.value.map(b => ({ label: b.label || `Class of ${b.year}`, value: b.year })),\n  ]\n}\n\nconst { data: members, refresh, pending } = await useAsyncData('directory', () =>\n  fetchDirectory({\n    search: search.value,\n    batchYear: selectedBatch.value || undefined,\n    page: currentPage.value,\n  }),\n)\n\nconst debounceTimeout = ref<ReturnType<typeof setTimeout>>()\nfunction onSearch() {\n  clearTimeout(debounceTimeout.value)\n  debounceTimeout.value = setTimeout(() => {\n    currentPage.value = 1\n    refresh()\n  }, 300)\n}\n\nwatch(selectedBatch, () => {\n  currentPage.value = 1\n  refresh()\n})\n</script>\n\n<template>\n  <div>\n    <div class=\"bg-white border-b border-slate-200 py-8 px-4\">\n      <div class=\"max-w-6xl mx-auto\">\n        <h1 class=\"text-2xl font-bold text-slate-900 mb-1\">Alumni Directory</h1>\n        <p class=\"text-slate-500 text-sm\">\n          {{ user ? 'Browse all active alumni' : 'Sign in to access full profiles and contact details' }}\n        </p>\n\n        <div class=\"mt-4 flex gap-3 flex-wrap\">\n          <div class=\"flex-1 min-w-64\">\n            <InputText\n              v-model=\"search\"\n              placeholder=\"Search by name or company...\"\n              class=\"w-full\"\n              @input=\"onSearch\"\n            />\n          </div>\n          <Select\n            v-model=\"selectedBatch\"\n            :options=\"batches\"\n            option-label=\"label\"\n            option-value=\"value\"\n            placeholder=\"All Batches\"\n            class=\"w-48\"\n          />\n        </div>\n      </div>\n    </div>\n\n    <div class=\"max-w-6xl mx-auto px-4 py-8\">\n      <div v-if=\"pending\" class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4\">\n        <div v-for=\"i in 8\" :key=\"i\" class=\"bg-white border border-slate-200 rounded-xl p-4 animate-pulse\">\n          <div class=\"flex gap-3\">\n            <div class=\"w-12 h-12 rounded-full bg-slate-200\" />\n            <div class=\"flex-1\">\n              <div class=\"h-4 bg-slate-200 rounded w-3/4 mb-2\" />\n              <div class=\"h-3 bg-slate-200 rounded w-1/2\" />\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div v-else-if=\"members && members.length > 0\" class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4\">\n        <MemberCard v-for=\"member in members\" :key=\"member.id\" :member=\"member\" />\n      </div>\n\n      <div v-else class=\"text-center py-16\">\n        <i class=\"pi pi-users text-4xl text-slate-300 mb-3 block\" />\n        <p class=\"text-slate-500\">No alumni found matching your search</p>\n      </div>\n\n      <!-- Guest prompt -->\n      <div v-if=\"!user\" class=\"mt-8 bg-primary-50 border border-primary-200 rounded-xl p-6 text-center\">\n        <h3 class=\"font-semibold text-slate-900 mb-2\">Want to see full profiles?</h3>\n        <p class=\"text-slate-600 text-sm mb-4\">Sign in or register to access complete alumni profiles with contact information.</p>\n        <div class=\"flex gap-3 justify-center\">\n          <NuxtLink to=\"/login\" class=\"px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700\">Sign In</NuxtLink>\n          <NuxtLink to=\"/register\" class=\"px-4 py-2 bg-primary-600 text-white rounded-lg text-sm font-medium\">Register</NuxtLink>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n"],"version":3}