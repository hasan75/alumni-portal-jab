,MAAA,IAAA,EAAK,QAAQ,cAAcA,MAAA,IAAA,EAAK,QAAQ,OAAK;;cAG7FA,MAAA,IAAA,EAAK,QAAQ,cAAcA,MAAA,IAAA,EAAK,QAAQ,OAAK;iHAElDC,cAAA,QAAI,UAAYD,MAAA,IAAA,EAAK,QAAQ,KAAK,EAAA,6DAAgDA,MAAA,IAAA,EAAK,QAAQ,KAAK;;;;cAE/FA,MAAA,IAAA,EAAK,QAAQ,cAAcA,MAAA,IAAA,EAAK,QAAQ,OAAK;wJAEtBA,MAAA,IAAA,EAAK,QAAQ,KAAK,CAAA,eAAA;AAAA;;;;;;;YAM7CA,MAAA,IAAA,EAAK,UAAU,SAAM,GAAA;;wBAGTA,MAAA,IAAA,EAAK,WAAS,CAArB,QAAG;AAKsC,kBAAA,yOAAAL,eAAA,IAAI,WAAW,CAAA,MAAA;AACvD,gBAAA,IAAI,QAAM;AAAoC,oBAAA,qCAAAA,eAAA,IAAI,MAAM,CAAA,EAAA;AAAe,kBAAA,IAAI,gBAAc;AAAQ,sBAAA,YAAAA,eAAA,IAAI,cAAc,CAAA,SAAA;AAAA;;;;;;;AAEvH,kBAAA,qCAAAA,eAAA,IAAI,UAAU,CAAA,EAAA;AAAe,gBAAA,IAAI,UAAQ;AAAQ,oBAAA,YAAAA,eAAA,IAAI,aAAU,YAAe,IAAI,QAAQ,CAAA,SAAA;AAAA;;;;;;;;;YAQ5FK,MAAA,IAAA,EAAK,KAAK,SAAM,GAAA;;wBAGJA,MAAA,IAAA,EAAK,MAAI,CAAhB,QAAG;mPAKsCL,eAAA,IAAI,SAAS,0CACzBA,eAAA,IAAI,OAAO;AAAe,gBAAA,IAAI,UAAQ;AAA+B,oBAAA,mCAAAA,eAAA,IAAI,QAAQ,CAAA,SAAA;AAAA;;;;AAC7G,gBAAA,IAAI,YAAU;AACd,oBAAA,qCAAAA,eAAA,IAAA,KAAK,IAAI,UAAU,EAAE,aAAW,CAAA,EAAA;AAAiB,kBAAA,IAAI,YAAY,IAAI,YAAU;iDAAQ,IAAI,aAAU,YAAA,IAAmB,KAAK,IAAI,QAAQ,EAAG,YAAA,CAAW,CAAA,SAAA;AAAA;;;;;;;;;;;;;YAQ7JK,MAAA,IAAA,EAAK,QAAQ,UAAUA,MAAA,IAAA,EAAK,QAAQ,OAAO,SAAM,GAAA;;AAItCE,wBAAAF,MAAA,IAAA,EAAK,QAAQ,SAAtB,UAAK;4HAIT,KAAK,CAAA,SAAA;AAAA;;;;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrInterpolate","_push","_parent","_createVNode","_withAsyncContext","_unref","_ssrRenderAttr","_ssrRenderList"],"sources":["../../../../../../../app/components/member/MemberProfileHeader.vue","../../../../../../../app/pages/directory/[id].vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { AlumniProfile } from '~/types/member'\n\ndefineProps<{\n  profile: AlumniProfile\n  isOwnProfile?: boolean\n}>()\n</script>\n\n<template>\n  <div class=\"bg-white border border-slate-200 rounded-xl overflow-hidden\">\n    <!-- Cover photo -->\n    <div class=\"h-32 bg-gradient-to-br from-primary-600 to-primary-800 relative\">\n      <img\n        v-if=\"profile.cover_photo_url\"\n        :src=\"profile.cover_photo_url\"\n        alt=\"Cover\"\n        class=\"w-full h-full object-cover\"\n      >\n    </div>\n\n    <div class=\"px-6 pb-6\">\n      <!-- Avatar (overlapping cover) -->\n      <div class=\"flex justify-between items-end -mt-12 mb-4\">\n        <div class=\"relative\">\n          <img\n            v-if=\"profile.avatar_url\"\n            :src=\"profile.avatar_url\"\n            :alt=\"profile.full_name\"\n            class=\"w-20 h-20 rounded-full border-4 border-white object-cover\"\n          >\n          <div\n            v-else\n            class=\"w-20 h-20 rounded-full border-4 border-white bg-primary-100 flex items-center justify-center text-primary-700 font-bold text-2xl\"\n          >\n            {{ profile.full_name.charAt(0).toUpperCase() }}\n          </div>\n          <div\n            v-if=\"profile.is_verified\"\n            class=\"absolute bottom-0 right-0 bg-primary-500 text-white rounded-full w-6 h-6 flex items-center justify-center\"\n            title=\"Verified Alumni\"\n          >\n            <i class=\"pi pi-check text-xs\" />\n          </div>\n        </div>\n        <NuxtLink\n          v-if=\"isOwnProfile\"\n          to=\"/profile\"\n          class=\"text-sm text-primary-600 hover:text-primary-700 font-medium flex items-center gap-1\"\n        >\n          <i class=\"pi pi-pencil text-xs\" />\n          Edit Profile\n        </NuxtLink>\n      </div>\n\n      <!-- Name & details -->\n      <h1 class=\"text-xl font-bold text-slate-900\">\n        {{ profile.display_name || profile.full_name }}\n      </h1>\n      <p v-if=\"profile.current_job_title\" class=\"text-slate-600 mt-0.5\">\n        {{ profile.current_job_title }}\n        <span v-if=\"profile.current_company\"> at {{ profile.current_company }}</span>\n      </p>\n\n      <div class=\"flex flex-wrap gap-3 mt-3\">\n        <span\n          v-if=\"profile.batch_year\"\n          class=\"inline-flex items-center gap-1 text-sm text-primary-700 bg-primary-50 px-3 py-1 rounded-full font-medium\"\n        >\n          <i class=\"pi pi-graduation-cap text-xs\" />\n          Class of {{ profile.batch_year }}\n        </span>\n        <span\n          v-if=\"profile.department\"\n          class=\"inline-flex items-center gap-1 text-sm text-slate-600\"\n        >\n          <i class=\"pi pi-book text-xs\" />\n          {{ profile.department }}\n        </span>\n        <span\n          v-if=\"profile.city || profile.country\"\n          class=\"inline-flex items-center gap-1 text-sm text-slate-600\"\n        >\n          <i class=\"pi pi-map-marker text-xs\" />\n          {{ [profile.city, profile.country].filter(Boolean).join(', ') }}\n        </span>\n      </div>\n\n      <p v-if=\"profile.bio\" class=\"mt-3 text-sm text-slate-600 leading-relaxed\">\n        {{ profile.bio }}\n      </p>\n    </div>\n  </div>\n</template>\n","<script setup lang=\"ts\">\nimport MemberProfileHeader from '~/components/member/MemberProfileHeader.vue'\n\nconst route = useRoute()\nconst id = route.params.id as string\n\ndefinePageMeta({ middleware: 'member-auth' })\n\nconst { fetchProfileWithDetails } = useMembers()\nconst user = useSupabaseUser()\n\nconst { data, pending, error } = await useAsyncData(`profile-${id}`, () =>\n  fetchProfileWithDetails(id),\n)\n\nif (!data.value && !pending.value) {\n  throw createError({ statusCode: 404, statusMessage: 'Profile not found' })\n}\n\nuseSeoMeta({\n  title: computed(() => `${data.value?.profile.display_name || data.value?.profile.full_name || 'Profile'} | Alumni Portal`),\n})\n</script>\n\n<template>\n  <div class=\"max-w-3xl mx-auto py-6 px-4\">\n    <NuxtLink to=\"/directory\" class=\"inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-primary-600 mb-4 transition-colors\">\n      <i class=\"pi pi-arrow-left text-xs\" />\n      Back to Directory\n    </NuxtLink>\n\n    <div v-if=\"pending\" class=\"space-y-4\">\n      <div class=\"bg-white border border-slate-200 rounded-xl h-64 animate-pulse\" />\n    </div>\n\n    <div v-else-if=\"data\" class=\"space-y-4\">\n      <MemberProfileHeader\n        :profile=\"data.profile\"\n        :is-own-profile=\"user?.id === data.profile.id\"\n      />\n\n      <!-- Contact info (only shown if privacy allows) -->\n      <div v-if=\"(data.profile.show_email && data.profile.email) || (data.profile.show_phone && data.profile.phone)\" class=\"bg-white border border-slate-200 rounded-xl p-4\">\n        <h2 class=\"font-semibold text-slate-900 mb-3\">Contact</h2>\n        <div class=\"space-y-2\">\n          <div v-if=\"data.profile.show_email && data.profile.email\" class=\"flex items-center gap-2 text-sm\">\n            <i class=\"pi pi-envelope text-slate-400\" />\n            <a :href=\"`mailto:${data.profile.email}`\" class=\"text-primary-600 hover:underline\">{{ data.profile.email }}</a>\n          </div>\n          <div v-if=\"data.profile.show_phone && data.profile.phone\" class=\"flex items-center gap-2 text-sm\">\n            <i class=\"pi pi-phone text-slate-400\" />\n            <span class=\"text-slate-700\">{{ data.profile.phone }}</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Education -->\n      <div v-if=\"data.education.length > 0\" class=\"bg-white border border-slate-200 rounded-xl p-4\">\n        <h2 class=\"font-semibold text-slate-900 mb-3\">Education</h2>\n        <div class=\"space-y-3\">\n          <div v-for=\"edu in data.education\" :key=\"edu.id\" class=\"flex gap-3\">\n            <div class=\"w-8 h-8 bg-primary-50 rounded-lg flex items-center justify-center shrink-0\">\n              <i class=\"pi pi-graduation-cap text-primary-600 text-sm\" />\n            </div>\n            <div>\n              <p class=\"font-medium text-slate-900 text-sm\">{{ edu.institution }}</p>\n              <p v-if=\"edu.degree\" class=\"text-sm text-slate-600\">{{ edu.degree }}<span v-if=\"edu.field_of_study\"> · {{ edu.field_of_study }}</span></p>\n              <p class=\"text-xs text-slate-400\">\n                {{ edu.start_year }}<span v-if=\"edu.end_year\"> – {{ edu.is_current ? 'Present' : edu.end_year }}</span>\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Work Experience -->\n      <div v-if=\"data.work.length > 0\" class=\"bg-white border border-slate-200 rounded-xl p-4\">\n        <h2 class=\"font-semibold text-slate-900 mb-3\">Work Experience</h2>\n        <div class=\"space-y-3\">\n          <div v-for=\"exp in data.work\" :key=\"exp.id\" class=\"flex gap-3\">\n            <div class=\"w-8 h-8 bg-slate-100 rounded-lg flex items-center justify-center shrink-0\">\n              <i class=\"pi pi-briefcase text-slate-500 text-sm\" />\n            </div>\n            <div>\n              <p class=\"font-medium text-slate-900 text-sm\">{{ exp.job_title }}</p>\n              <p class=\"text-sm text-slate-600\">{{ exp.company }}<span v-if=\"exp.location\" class=\"text-slate-400\"> · {{ exp.location }}</span></p>\n              <p v-if=\"exp.start_date\" class=\"text-xs text-slate-400\">\n                {{ new Date(exp.start_date).getFullYear() }}<span v-if=\"exp.end_date || exp.is_current\"> – {{ exp.is_current ? 'Present' : new Date(exp.end_date!).getFullYear() }}</span>\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Skills -->\n      <div v-if=\"data.profile.skills && data.profile.skills.length > 0\" class=\"bg-white border border-slate-200 rounded-xl p-4\">\n        <h2 class=\"font-semibold text-slate-900 mb-3\">Skills</h2>\n        <div class=\"flex flex-wrap gap-2\">\n          <span\n            v-for=\"skill in data.profile.skills\"\n            :key=\"skill\"\n            class=\"px-3 py-1 bg-primary-50 text-primary-700 rounded-full text-sm font-medium\"\n          >\n            {{ skill }}\n          </span>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n"],"version":3}