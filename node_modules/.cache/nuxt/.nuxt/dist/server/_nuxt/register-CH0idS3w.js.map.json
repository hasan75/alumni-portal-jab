ACb,aAAY;AAAA,UACZ,OAAM;AAAA,UACL,UAAUA,MAAA,OAAA;AAAA,QAAA;;;UAOS,YAAAA,MAAA,IAAA,EAAK;AAAA,UAAL,uBAAA,CAAA,WAAAA,MAAA,IAAA,EAAK,aAAU;AAAA,UAAE,aAAY;AAAA,UAAW,OAAM;AAAA,UAAU,UAAUA,MAAA,OAAA;AAAA,QAAA;;;UAIlE,YAAAA,MAAA,IAAA,EAAK;AAAA,UAAL,uBAAA,CAAA,WAAAA,MAAA,IAAA,EAAK,QAAK;AAAA,UAAE,aAAY;AAAA,UAAW,OAAM;AAAA,UAAU,UAAUA,MAAA,OAAA;AAAA,QAAA;;;UAKnF,MAAK;AAAA,UACL,OAAM;AAAA,UACN,MAAK;AAAA,UACL,OAAM;AAAA,UACL,SAASA,MAAA,OAAA;AAAA,QAAA;;;UAMF,IAAG;AAAA,UAAS,OAAM;AAAA,QAAA;2BAA5B,CAEW,GAAAF,QAAAC,UAAA,aAAA;;;;;gCAFqE,WAEhF;AAAA,cAAA;AAAA;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_unref","_createVNode"],"sources":["../../../../../../../app/pages/register.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport InputText from 'primevue/inputtext'\nimport Password from 'primevue/password'\nimport Button from 'primevue/button'\nimport Message from 'primevue/message'\nimport Select from 'primevue/select'\n\ndefinePageMeta({ layout: false })\n\nuseSeoMeta({\n  title: 'Register | Alumni Portal',\n})\n\nconst { fetchBatches } = useMembers()\nconst { appName, institutionName } = useSiteConfig()\n\nconst batches = ref<{ label: string, value: number }[]>([])\n\nconst form = reactive({\n  full_name: '',\n  email: '',\n  password: '',\n  confirm_password: '',\n  batch_year: null as number | null,\n  student_id: '',\n  phone: '',\n})\n\nconst loading = ref(false)\nconst error = ref('')\nconst submitted = ref(false)\n\nonMounted(async () => {\n  const batchList = await fetchBatches()\n  batches.value = batchList.map(b => ({ label: b.label || `Class of ${b.year}`, value: b.year }))\n})\n\nasync function handleRegister() {\n  if (!form.full_name || !form.email || !form.password) {\n    error.value = 'Please fill in all required fields'\n    return\n  }\n  if (form.password !== form.confirm_password) {\n    error.value = 'Passwords do not match'\n    return\n  }\n  if (form.password.length < 8) {\n    error.value = 'Password must be at least 8 characters'\n    return\n  }\n\n  loading.value = true\n  error.value = ''\n\n  try {\n    const response = await $fetch('/api/auth/register', {\n      method: 'POST',\n      body: {\n        email: form.email,\n        password: form.password,\n        full_name: form.full_name,\n        batch_year: form.batch_year,\n        student_id: form.student_id || undefined,\n        phone: form.phone || undefined,\n      },\n    })\n\n    if (response.success) {\n      submitted.value = true\n    }\n  }\n  catch (e: any) {\n    error.value = e.data?.statusMessage || e.message || 'Registration failed'\n  }\n  finally {\n    loading.value = false\n  }\n}\n</script>\n\n<template>\n  <div class=\"min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-primary-900 flex items-center justify-center p-4 py-12\">\n    <div class=\"w-full max-w-lg\">\n      <!-- Logo -->\n      <div class=\"text-center mb-8\">\n        <NuxtLink to=\"/\" class=\"inline-flex items-center gap-3\">\n          <div class=\"flex h-12 w-12 items-center justify-center rounded-xl bg-primary-500 text-white text-xl font-bold shadow-lg\">\n            A\n          </div>\n          <div class=\"text-left\">\n            <h1 class=\"text-xl font-bold text-white\">{{ appName }}</h1>\n            <p class=\"text-sm text-slate-400\">{{ institutionName }}</p>\n          </div>\n        </NuxtLink>\n      </div>\n\n      <!-- Success state -->\n      <div v-if=\"submitted\" class=\"bg-white rounded-2xl shadow-2xl p-8 text-center\">\n        <div class=\"w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4\">\n          <i class=\"pi pi-check text-green-600 text-2xl\" />\n        </div>\n        <h2 class=\"text-2xl font-bold text-slate-900 mb-2\">Application Submitted!</h2>\n        <p class=\"text-slate-500 mb-6\">\n          Your registration is pending admin approval. You will be notified once your account is activated.\n        </p>\n        <NuxtLink to=\"/\" class=\"text-primary-600 hover:underline text-sm\">\n          Return to Homepage\n        </NuxtLink>\n      </div>\n\n      <!-- Form -->\n      <div v-else class=\"bg-white rounded-2xl shadow-2xl p-8\">\n        <h2 class=\"text-2xl font-bold text-slate-900 text-center mb-2\">Create Account</h2>\n        <p class=\"text-slate-500 text-center mb-6\">Join the alumni network</p>\n\n        <Message v-if=\"error\" severity=\"error\" class=\"mb-4\" :closable=\"false\">\n          {{ error }}\n        </Message>\n\n        <form class=\"space-y-4\" @submit.prevent=\"handleRegister\">\n          <div>\n            <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Full Name *</label>\n            <InputText v-model=\"form.full_name\" placeholder=\"Your full name\" class=\"w-full\" :disabled=\"loading\" />\n          </div>\n\n          <div>\n            <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Email *</label>\n            <InputText v-model=\"form.email\" type=\"email\" placeholder=\"you@example.com\" class=\"w-full\" :disabled=\"loading\" />\n          </div>\n\n          <div class=\"grid grid-cols-2 gap-4\">\n            <div>\n              <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Password *</label>\n              <Password\n                v-model=\"form.password\"\n                placeholder=\"Min 8 characters\"\n                :feedback=\"false\"\n                toggle-mask\n                class=\"w-full\"\n                input-class=\"w-full\"\n                :disabled=\"loading\"\n              />\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Confirm Password *</label>\n              <Password\n                v-model=\"form.confirm_password\"\n                placeholder=\"Repeat password\"\n                :feedback=\"false\"\n                toggle-mask\n                class=\"w-full\"\n                input-class=\"w-full\"\n                :disabled=\"loading\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Graduation Year</label>\n            <Select\n              v-model=\"form.batch_year\"\n              :options=\"batches\"\n              option-label=\"label\"\n              option-value=\"value\"\n              placeholder=\"Select your batch\"\n              class=\"w-full\"\n              :disabled=\"loading\"\n            />\n          </div>\n\n          <div class=\"grid grid-cols-2 gap-4\">\n            <div>\n              <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Student ID</label>\n              <InputText v-model=\"form.student_id\" placeholder=\"Optional\" class=\"w-full\" :disabled=\"loading\" />\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-slate-700 mb-1.5\">Phone</label>\n              <InputText v-model=\"form.phone\" placeholder=\"Optional\" class=\"w-full\" :disabled=\"loading\" />\n            </div>\n          </div>\n\n          <Button\n            type=\"submit\"\n            label=\"Submit Application\"\n            icon=\"pi pi-user-plus\"\n            class=\"w-full\"\n            :loading=\"loading\"\n          />\n        </form>\n\n        <div class=\"mt-5 text-center text-sm text-slate-500\">\n          Already have an account?\n          <NuxtLink to=\"/login\" class=\"text-primary-600 font-medium hover:underline ml-1\">\n            Sign in\n          </NuxtLink>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n"],"version":3}