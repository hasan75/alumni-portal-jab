JFG,YAKEH,MAAAU,QAAA,GAAA;AAAA,gBAJC,OAAOV,MAAA,IAAA,GAAM,OAAO,UAAU,YAAA,KAAW;AAAA,gBAC1C,OAAM;AAAA,gBACN,OAAM;AAAA,gBACN,OAAA,EAAA,SAAA,QAAA,UAAA,OAAA;AAAA,cAAA;;;;;;;iBAGM;AAAA,QAAJ,KAAI;AAAA,QAAY,OAAOA,MAAA,aAAA;AAAA,QAAe,OAAA;AAAA,MAAA;;;QAKhC,SAASA,MAAA,cAAA;AAAA,gEAAA,eAAc,QAAA,SAAA;AAAA,QAAE,UAAS;AAAA,QAAO,OAAM;AAAA,QAAQ,mBAAiB;AAAA,MAAA;QAC3E,gBAAX,CAUW,GAAAC,QAAAC,UAAA,aAAA;;yRAJsCF,MAAA,OAAA,CAAO;;;cALtDG,YAQM,OAAA,EARD,OAAM,6BAAyB;AAAA,gBAClCA,YAEM,OAAA,EAFD,OAAM,kGAAA,GAAkG,KAE7G;AAAA,gBACAA,YAGM,OAAA,MAAA;AAAA,kBAFJA,YAAyD,KAAA,EAAtD,OAAM,+BAAA,mBAAkCH,MAAA,OAAA,CAAO,GAAA,CAAA;AAAA,kBAClDG,YAAiD,KAAA,EAA9C,OAAM,yBAAA,GAAyB,aAAW;AAAA,gBAAA;;;;;yBARrD,CA2DS,GAAAF,QAAAC,UAAA,aAAA;;;cA5CmB,SAAQ,kBAAA;;AAUTI,0BAAAN,MAAA,WAAA,IAAX,YAAO;+MAGVO,eAAA,QAAQ,KAAK;4BAIH,QAAQ,OAAK,CAArB,SAAI;;kBAGa,SAAS,KAAK,EAAE;uHAO7BC,eAAA,KAAK,IAAI,qDACID,eAAA,KAAK,KAAK;AAE1B,oBAAA,KAAK,OAAK;8HAGbA,eAAA,KAAK,KAAK;;;;;;;;;;cAKP,IAAG;AAAA,cAAI,QAAO;AAAA,cAAS,OAAM;AAAA,YAAA;+BAAvC,CAGWI,IAAAV,QAAAC,UAAAU,cAAA;;;;;oBAFTT,YAAiC,KAAA,EAA9B,OAAM,uBAAqB;AAAA,oBAC9BA,YAAsB,cAAhB,WAAS;AAAA,kBAAA;AAAA;;;;;;;cA3CrBA,YA8CM,OAAA,EA9CD,OAAM,UAAM;AAAA,gBACfA,YAWS,UAAA;AAAA,kBAVP,QAAM,0EAAwE;AAAA,oBACxD,SAAQ,kBAAA;;kBAK7B,qBAAO,iBAAgB,kBAAA;AAAA,gBAAA;kBAExBA,YAA4B,KAAA,EAAzB,OAAM,kBAAgB;AAAA,kBACzBA,YAAsB,cAAhB,WAAS;AAAA,gBAAA;kCAEjBE,YA0BMQ,UAAA,MAAAC,WA1BiBd,MAAA,WAAA,GAAW,CAAtB,YAAO;sCAAnBK,YA0BM,OAAA;AAAA,oBA1B+B,KAAK,QAAQ;AAAA,oBAAK,OAAM;AAAA,kBAAA;oBAC3DF,YAIM,OAAA,EAJD,OAAM,mDAA+C;AAAA,sBACxDA,YAEI,OAFD,OAAM,gEAAA,GAA+DM,gBACnE,QAAQ,KAAK,GAAA,CAAA;AAAA,oBAAA;qBAGpBL,UAAA,IAAA,GAAAC,YAmBSQ,UAAA,MAAAC,WAlBQ,QAAQ,QAAhB,SAAI;0CADbT,YAmBS,UAAA;AAAA,wBAjBN,KAAK,KAAK;AAAA,wBACX,QAAM,0EAAwE;AAAA,0BACtD,SAAS,KAAK,EAAE;;wBAKvC,SAAK,CAAA,WAAE,iBAAiB,KAAK,EAAE;AAAA,sBAAA;wBAEhCF,YAAwB,KAAA;AAAA,0BAApB,OAAO,KAAK;AAAA,wBAAA;wBAChBA,YAA4C,UAAtC,OAAM,SAAA,GAAQM,gBAAI,KAAK,KAAK,GAAA,CAAA;AAAA,wBAE1B,KAAK,sBADbJ,YAKO,QAAA;AAAA;0BAHL,OAAM;AAAA,wBAAA,GAEHI,gBAAA,KAAK,KAAK,GAAA,CAAA;;;;;gBAInBN,YAKM,OAAA,EALD,OAAM,yCAAqC;AAAA,kBAC9CA,YAGW,qBAAA;AAAA,oBAHD,IAAG;AAAA,oBAAI,QAAO;AAAA,oBAAS,OAAM;AAAA,kBAAA;qCACrC,MAAiC;AAAA,sBAAjCA,YAAiC,KAAA,EAA9B,OAAM,uBAAqB;AAAA,sBAC9BA,YAAsB,cAAhB,WAAS;AAAA,oBAAA;;;;;;;;;;4CASbH,MAAA,gBAAA,IAAgB,aAAA,YAAA,gDAAA,CAAA,CAAA,4BAAA;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_push","_parent","_createVNode","_openBlock","_createBlock","_ssrRenderList","_ssrInterpolate","_ssrRenderClass","_toDisplayString","Avatar","_","_scopeId","_Fragment","_renderList"],"sources":["../../../../../../../app/layouts/admin.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport Menu from 'primevue/menu'\nimport Button from 'primevue/button'\nimport Avatar from 'primevue/avatar'\nimport Drawer from 'primevue/drawer'\n\nconst user = useSupabaseUser()\nconst supabase = useSupabaseClient()\nconst route = useRoute()\n\nconst { appName } = useSiteConfig()\n\nconst mobileMenuOpen = ref(false)\nconst sidebarCollapsed = ref(false)\n\nconst pendingCount = ref(0)\n\nconst navSections = computed(() => [\n  {\n    key: 'members',\n    label: 'Members',\n    items: [\n      { label: 'All Members', icon: 'pi pi-users', to: '/admin/members' },\n      {\n        label: 'Pending Approval',\n        icon: 'pi pi-clock',\n        to: '/admin/members?status=pending',\n        badge: pendingCount.value > 0 ? String(pendingCount.value) : undefined,\n      },\n      { label: 'Batches', icon: 'pi pi-calendar', to: '/admin/batches' },\n    ],\n  },\n  {\n    key: 'content',\n    label: 'Content',\n    items: [\n      { label: 'Events', icon: 'pi pi-calendar-plus', to: '/admin/events' },\n      { label: 'News', icon: 'pi pi-megaphone', to: '/admin/news' },\n      { label: 'Jobs', icon: 'pi pi-briefcase', to: '/admin/jobs' },\n      { label: 'Feed Moderation', icon: 'pi pi-comments', to: '/admin/feed' },\n    ],\n  },\n  {\n    key: 'settings',\n    label: 'Settings',\n    items: [\n      { label: 'App Settings', icon: 'pi pi-cog', to: '/admin/settings' },\n    ],\n  },\n])\n\nconst userMenu = ref()\nconst userMenuItems = ref([\n  {\n    label: user.value?.email || 'Admin',\n    items: [\n      {\n        label: 'Sign Out',\n        icon: 'pi pi-sign-out',\n        command: async () => {\n          await supabase.auth.signOut()\n          navigateTo('/admin/login')\n        },\n      },\n    ],\n  },\n])\n\nfunction toggleUserMenu(event: Event) {\n  userMenu.value.toggle(event)\n}\n\nfunction isActive(path: string) {\n  if (route.path === path) return true\n  if (route.path.startsWith(`${path}/`)) {\n    const allNavPaths = navSections.value.flatMap(s => s.items.map(i => i.to))\n    const hasMoreSpecificMatch = allNavPaths.some(p => p !== path && route.path.startsWith(p))\n    return !hasMoreSpecificMatch\n  }\n  return false\n}\n\nfunction navigateAndClose(to: string) {\n  navigateTo(to)\n  mobileMenuOpen.value = false\n}\n\nonMounted(async () => {\n  // Fetch pending count\n  const supabaseClient = useSupabaseClient()\n  const { count } = await supabaseClient\n    .from('alumni_profiles')\n    .select('id', { count: 'exact', head: true })\n    .eq('status', 'pending')\n  pendingCount.value = count || 0\n})\n</script>\n\n<template>\n  <div class=\"min-h-screen bg-slate-100\">\n    <!-- Sidebar (Desktop) -->\n    <aside\n      class=\"fixed left-0 top-0 z-40 h-screen bg-white border-r border-slate-200 transition-all duration-300 hidden lg:block\"\n      :class=\"sidebarCollapsed ? 'w-16' : 'w-60'\"\n    >\n      <!-- Logo -->\n      <div class=\"flex h-14 items-center justify-between px-3 border-b border-slate-100\">\n        <NuxtLink v-if=\"!sidebarCollapsed\" to=\"/admin/dashboard\" class=\"flex items-center gap-2\">\n          <div class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-primary-600 text-white font-bold text-sm\">\n            A\n          </div>\n          <div>\n            <p class=\"font-semibold text-slate-900 text-sm leading-tight\">{{ appName }}</p>\n            <p class=\"text-[10px] text-slate-400\">Admin Panel</p>\n          </div>\n        </NuxtLink>\n        <div v-else class=\"w-full flex justify-center\">\n          <div class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-primary-600 text-white font-bold text-sm\">\n            A\n          </div>\n        </div>\n      </div>\n\n      <!-- Navigation -->\n      <nav class=\"flex flex-col h-[calc(100vh-3.5rem)] overflow-y-auto\">\n        <div class=\"flex-1 py-3 px-2\">\n          <!-- Dashboard -->\n          <NuxtLink\n            to=\"/admin/dashboard\"\n            class=\"flex items-center gap-3 rounded-lg px-3 py-2 mb-2 text-sm font-medium transition-colors\"\n            :class=\"[\n              isActive('/admin/dashboard')\n                ? 'bg-primary-50 text-primary-700'\n                : 'text-slate-600 hover:bg-slate-50',\n            ]\"\n            :title=\"sidebarCollapsed ? 'Dashboard' : undefined\"\n          >\n            <i class=\"pi pi-th-large\" />\n            <span v-if=\"!sidebarCollapsed\">Dashboard</span>\n          </NuxtLink>\n\n          <!-- Sections -->\n          <div v-for=\"section in navSections\" :key=\"section.key\" class=\"mb-4\">\n            <div v-if=\"!sidebarCollapsed\" class=\"flex items-center justify-between px-3 py-1.5\">\n              <p class=\"text-[10px] font-semibold uppercase tracking-wider text-slate-400\">\n                {{ section.label }}\n              </p>\n            </div>\n            <div v-else class=\"border-t border-slate-100 my-2\" />\n\n            <NuxtLink\n              v-for=\"item in section.items\"\n              :key=\"item.to\"\n              :to=\"item.to\"\n              class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-colors\"\n              :class=\"[\n                isActive(item.to)\n                  ? 'bg-primary-50 text-primary-700 font-medium'\n                  : 'text-slate-600 hover:bg-slate-50',\n              ]\"\n              :title=\"sidebarCollapsed ? item.label : undefined\"\n            >\n              <i :class=\"item.icon\" class=\"text-base\" />\n              <span v-if=\"!sidebarCollapsed\" class=\"flex-1\">{{ item.label }}</span>\n              <span\n                v-if=\"!sidebarCollapsed && item.badge\"\n                class=\"text-[10px] font-bold bg-red-100 text-red-700 px-1.5 py-0.5 rounded-full\"\n              >\n                {{ item.badge }}\n              </span>\n            </NuxtLink>\n          </div>\n        </div>\n\n        <!-- Footer -->\n        <div class=\"border-t border-slate-100 p-2\">\n          <NuxtLink\n            to=\"/\"\n            target=\"_blank\"\n            class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-slate-500 hover:bg-slate-50 transition-colors\"\n            :title=\"sidebarCollapsed ? 'View Site' : undefined\"\n          >\n            <i class=\"pi pi-external-link\" />\n            <span v-if=\"!sidebarCollapsed\">View Site</span>\n          </NuxtLink>\n          <button\n            class=\"w-full flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-slate-500 hover:bg-slate-50 transition-colors\"\n            @click=\"sidebarCollapsed = !sidebarCollapsed\"\n          >\n            <i :class=\"sidebarCollapsed ? 'pi pi-angle-double-right' : 'pi pi-angle-double-left'\" />\n            <span v-if=\"!sidebarCollapsed\">Collapse</span>\n          </button>\n        </div>\n      </nav>\n    </aside>\n\n    <!-- Top Header -->\n    <header\n      class=\"fixed top-0 right-0 z-30 h-14 bg-white border-b border-slate-200 flex items-center justify-between px-4 transition-all duration-300\"\n      :class=\"sidebarCollapsed ? 'lg:left-16' : 'lg:left-60'\"\n      style=\"left: 0;\"\n    >\n      <div class=\"flex items-center gap-3\">\n        <Button\n          icon=\"pi pi-bars\"\n          text\n          rounded\n          class=\"lg:hidden text-slate-600\"\n          @click=\"mobileMenuOpen = true\"\n        />\n        <NuxtLink to=\"/admin/dashboard\" class=\"lg:hidden flex items-center gap-2\">\n          <div class=\"flex h-7 w-7 items-center justify-center rounded-lg bg-primary-600 text-white font-bold text-xs\">\n            A\n          </div>\n        </NuxtLink>\n      </div>\n\n      <div class=\"flex items-center gap-3\">\n        <span class=\"text-sm text-slate-500 hidden sm:inline\">{{ user?.email }}</span>\n        <Button text rounded class=\"p-0\" @click=\"toggleUserMenu\">\n          <Avatar\n            :label=\"user?.email?.charAt(0).toUpperCase() || 'A'\"\n            shape=\"circle\"\n            class=\"bg-primary-100 text-primary-700\"\n            style=\"width: 32px; height: 32px;\"\n          />\n        </Button>\n        <Menu ref=\"userMenu\" :model=\"userMenuItems\" popup />\n      </div>\n    </header>\n\n    <!-- Mobile Drawer -->\n    <Drawer v-model:visible=\"mobileMenuOpen\" position=\"left\" class=\"w-72\" :show-close-icon=\"true\">\n      <template #header>\n        <div class=\"flex items-center gap-2\">\n          <div class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-primary-600 text-white font-bold text-sm\">\n            A\n          </div>\n          <div>\n            <p class=\"font-semibold text-slate-900\">{{ appName }}</p>\n            <p class=\"text-xs text-slate-500\">Admin Panel</p>\n          </div>\n        </div>\n      </template>\n      <nav class=\"py-2\">\n        <button\n          class=\"w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors\"\n          :class=\"[\n            isActive('/admin/dashboard')\n              ? 'bg-primary-50 text-primary-700 font-medium'\n              : 'text-slate-700 hover:bg-slate-50',\n          ]\"\n          @click=\"navigateAndClose('/admin/dashboard')\"\n        >\n          <i class=\"pi pi-th-large\" />\n          <span>Dashboard</span>\n        </button>\n        <div v-for=\"section in navSections\" :key=\"section.key\" class=\"mt-4\">\n          <div class=\"flex items-center justify-between px-4 py-1.5\">\n            <p class=\"text-xs font-semibold uppercase tracking-wider text-slate-400\">\n              {{ section.label }}\n            </p>\n          </div>\n          <button\n            v-for=\"item in section.items\"\n            :key=\"item.to\"\n            class=\"w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors\"\n            :class=\"[\n              isActive(item.to)\n                ? 'bg-primary-50 text-primary-700 font-medium'\n                : 'text-slate-700 hover:bg-slate-50',\n            ]\"\n            @click=\"navigateAndClose(item.to)\"\n          >\n            <i :class=\"item.icon\" />\n            <span class=\"flex-1\">{{ item.label }}</span>\n            <span\n              v-if=\"item.badge\"\n              class=\"text-[10px] font-bold bg-red-100 text-red-700 px-1.5 py-0.5 rounded-full\"\n            >\n              {{ item.badge }}\n            </span>\n          </button>\n        </div>\n        <div class=\"mt-6 pt-4 border-t border-slate-100\">\n          <NuxtLink to=\"/\" target=\"_blank\" class=\"flex items-center gap-3 px-4 py-2.5 text-slate-600 hover:bg-slate-50\">\n            <i class=\"pi pi-external-link\" />\n            <span>View Site</span>\n          </NuxtLink>\n        </div>\n      </nav>\n    </Drawer>\n\n    <!-- Main Content -->\n    <main\n      class=\"pt-14 min-h-screen transition-all duration-300\"\n      :class=\"sidebarCollapsed ? 'lg:ml-16' : 'lg:ml-60'\"\n    >\n      <div class=\"p-4 lg:p-6\">\n        <slot />\n      </div>\n    </main>\n  </div>\n</template>\n"],"version":3}