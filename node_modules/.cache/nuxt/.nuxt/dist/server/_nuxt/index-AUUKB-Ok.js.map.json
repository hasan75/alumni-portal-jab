gBAAa,QAAO;AAAA,cAAA;gBACrB,MAAIE,QACb,CAAwF,EADvE,WAAI;AAAA,kBACT,KAAK,2BAAjBJ,YAAwF,QAAA;AAAA;oBAA3D,OAAM;AAAA,kBAAA,GAA4BF,gBAAA,KAAK,UAAU,GAAA,CAAA,mBAC9EE,YAA4C,QAAA;AAAA;oBAA/B,OAAM;AAAA,kBAAA,GAAiB,GAAC;AAAA,gBAAA;;;cAGzCD,YAISR,MAAAW,QAAA,GAAA;AAAA,gBAJD,OAAM;AAAA,gBAAS,QAAO;AAAA,cAAA;gBACjB,MAAIE,QACb,CAA2C,EAD1B,WAAI;AAAA,kBACrBL,YAA2C,mBAAA;AAAA,oBAAvB,QAAQ,KAAK;AAAA,kBAAA;;;;cAGrCA,YAISR,MAAAW,QAAA,GAAA;AAAA,gBAJD,OAAM;AAAA,gBAAa,QAAO;AAAA,cAAA;gBACrB,MAAIE,QACb,CAA6E,EAD5D,WAAI;AAAA,kBACrBL,YAA6E,QAAA,EAAvE,OAAM,yBAAA,mBAA4B,WAAW,KAAK,UAAU,CAAA,GAAA,CAAA;AAAA,gBAAA;;;cAGtEA,YAmCSR,MAAAW,QAAA,GAAA,EAnCD,QAAO,aAAS;AAAA,gBACX,MAAIE,QACb,CA+BM,EAhCW,WAAI;AAAA,kBACrBL,YA+BM,OAAA,EA/BD,OAAM,kBAAc;AAAA,oBAEf,KAAK,WAAM,0BADnBC,YAQET,MAAAY,QAAA,GAAA;AAAA;sBANA,MAAK;AAAA,sBACL,MAAK;AAAA,sBACL,UAAS;AAAA,sBACT,MAAA;AAAA,sBACA,OAAM;AAAA,sBACL,SAAK,CAAA,WAAE,cAAa,CAAE,KAAK,EAAE,CAAA;AAAA,oBAAA;oBAGxB,KAAK,WAAM,0BADnBH,YAQET,MAAAY,QAAA,GAAA;AAAA;sBANA,MAAK;AAAA,sBACL,MAAK;AAAA,sBACL,UAAS;AAAA,sBACT,MAAA;AAAA,sBACA,OAAM;AAAA,sBACL,SAAK,CAAA,WAAE,aAAa,KAAK,IAAI,KAAK,SAAS;AAAA,oBAAA;oBAGtC,KAAK,WAAM,yBADnBH,YAQET,MAAAY,QAAA,GAAA;AAAA;sBANA,MAAK;AAAA,sBACL,MAAK;AAAA,sBACL,UAAS;AAAA,sBACT,MAAA;AAAA,sBACA,OAAM;AAAA,sBACL,SAAK,CAAA,WAAE,cAAc,KAAK,IAAI,KAAK,SAAS;AAAA,oBAAA;oBAE/CJ,YAEW,qBAAA;AAAA,sBAFA,IAAE,kBAAoB,KAAK,EAAE;AAAA,oBAAA;uCACtC,MAA6D;AAAA,wBAA7DA,YAA6DR,MAAAY,QAAA,GAAA;AAAA,0BAArD,MAAK;AAAA,0BAAe,MAAK;AAAA,0BAAQ,MAAA;AAAA,0BAAK,OAAM;AAAA,wBAAA;;;;;;;;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_push","_parent","_scopeId","_","_ssrInterpolate","_createTextVNode","_toDisplayString","_createVNode","_createBlock","_ssrRenderComponent","Column","Button","_withCtx"],"sources":["../../../../../../../app/pages/admin/members/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport DataTable from 'primevue/datatable'\nimport Column from 'primevue/column'\nimport Button from 'primevue/button'\nimport InputText from 'primevue/inputtext'\nimport Select from 'primevue/select'\nimport Tag from 'primevue/tag'\nimport MemberStatusBadge from '~/components/admin/members/MemberStatusBadge.vue'\n\ndefinePageMeta({ layout: 'admin', middleware: 'admin-auth' })\nuseSeoMeta({ title: 'Members | Admin', robots: 'noindex' })\n\nconst route = useRoute()\nconst { fetchAllForAdmin, approveMembers, rejectMember, suspendMember, fetchPendingCount } = useMembers()\nconst toast = useToast()\nconst confirm = useConfirm()\n\nconst search = ref('')\nconst statusFilter = ref((route.query.status as string) || '')\nconst currentPage = ref(1)\nconst selectedMembers = ref<any[]>([])\n\nconst statusOptions = [\n  { label: 'All Status', value: '' },\n  { label: 'Pending', value: 'pending' },\n  { label: 'Active', value: 'active' },\n  { label: 'Suspended', value: 'suspended' },\n  { label: 'Rejected', value: 'rejected' },\n]\n\nconst members = ref<any[]>([])\nconst totalCount = ref(0)\nconst loading = ref(false)\n\nasync function loadMembers() {\n  loading.value = true\n  const result = await fetchAllForAdmin({\n    search: search.value || undefined,\n    status: statusFilter.value || undefined,\n    page: currentPage.value,\n    perPage: 20,\n  })\n  members.value = result\n  loading.value = false\n}\n\nonMounted(loadMembers)\n\nconst debounceTimeout = ref<ReturnType<typeof setTimeout>>()\nfunction onSearch() {\n  clearTimeout(debounceTimeout.value)\n  debounceTimeout.value = setTimeout(() => {\n    currentPage.value = 1\n    loadMembers()\n  }, 300)\n}\n\nwatch(statusFilter, () => {\n  currentPage.value = 1\n  loadMembers()\n})\n\nasync function handleApprove(ids: string[]) {\n  const result = await approveMembers(ids)\n  if (result.success) {\n    toast.add({ severity: 'success', summary: `${ids.length} member(s) approved`, life: 3000 })\n    await loadMembers()\n    selectedMembers.value = []\n  }\n}\n\nasync function handleReject(id: string, name: string) {\n  confirm.require({\n    message: `Reject ${name}'s application?`,\n    header: 'Confirm Rejection',\n    icon: 'pi pi-exclamation-triangle',\n    rejectClass: 'p-button-secondary',\n    accept: async () => {\n      const result = await rejectMember(id)\n      if (result.success) {\n        toast.add({ severity: 'info', summary: 'Member rejected', life: 2000 })\n        await loadMembers()\n      }\n    },\n  })\n}\n\nasync function handleSuspend(id: string, name: string) {\n  confirm.require({\n    message: `Suspend ${name}'s account?`,\n    header: 'Confirm Suspension',\n    icon: 'pi pi-exclamation-triangle',\n    rejectClass: 'p-button-secondary',\n    accept: async () => {\n      const result = await suspendMember(id)\n      if (result.success) {\n        toast.add({ severity: 'warn', summary: 'Member suspended', life: 2000 })\n        await loadMembers()\n      }\n    },\n  })\n}\n\nfunction formatDate(dateStr: string) {\n  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n}\n</script>\n\n<template>\n  <div class=\"space-y-4\">\n    <div class=\"flex items-center justify-between flex-wrap gap-3\">\n      <div>\n        <h1 class=\"text-xl font-bold text-slate-900\">Members</h1>\n        <p class=\"text-slate-500 text-sm\">Manage alumni member accounts</p>\n      </div>\n    </div>\n\n    <!-- Filters -->\n    <div class=\"flex gap-3 flex-wrap\">\n      <InputText\n        v-model=\"search\"\n        placeholder=\"Search by name or email...\"\n        class=\"flex-1 min-w-48\"\n        @input=\"onSearch\"\n      />\n      <Select\n        v-model=\"statusFilter\"\n        :options=\"statusOptions\"\n        option-label=\"label\"\n        option-value=\"value\"\n        class=\"w-40\"\n      />\n      <Button\n        v-if=\"selectedMembers.length > 0\"\n        :label=\"`Approve Selected (${selectedMembers.length})`\"\n        icon=\"pi pi-check\"\n        severity=\"success\"\n        @click=\"handleApprove(selectedMembers.map(m => m.id))\"\n      />\n    </div>\n\n    <div class=\"bg-white border border-slate-200 rounded-xl overflow-hidden\">\n      <DataTable\n        v-model:selection=\"selectedMembers\"\n        :value=\"members\"\n        :loading=\"loading\"\n        data-key=\"id\"\n        class=\"text-sm\"\n      >\n        <Column selection-mode=\"multiple\" header-style=\"width: 3rem\" />\n        <Column field=\"full_name\" header=\"Name\">\n          <template #body=\"{ data }\">\n            <NuxtLink :to=\"`/admin/members/${data.id}`\" class=\"font-medium text-slate-900 hover:text-primary-600\">\n              {{ data.full_name }}\n            </NuxtLink>\n          </template>\n        </Column>\n        <Column field=\"email\" header=\"Email\" class=\"text-slate-600\" />\n        <Column field=\"batch_year\" header=\"Batch\">\n          <template #body=\"{ data }\">\n            <span v-if=\"data.batch_year\" class=\"text-sm text-slate-600\">{{ data.batch_year }}</span>\n            <span v-else class=\"text-slate-400\">—</span>\n          </template>\n        </Column>\n        <Column field=\"status\" header=\"Status\">\n          <template #body=\"{ data }\">\n            <MemberStatusBadge :status=\"data.status\" />\n          </template>\n        </Column>\n        <Column field=\"created_at\" header=\"Registered\">\n          <template #body=\"{ data }\">\n            <span class=\"text-slate-500 text-xs\">{{ formatDate(data.created_at) }}</span>\n          </template>\n        </Column>\n        <Column header=\"Actions\">\n          <template #body=\"{ data }\">\n            <div class=\"flex gap-1.5\">\n              <Button\n                v-if=\"data.status === 'pending'\"\n                icon=\"pi pi-check\"\n                size=\"small\"\n                severity=\"success\"\n                text\n                title=\"Approve\"\n                @click=\"handleApprove([data.id])\"\n              />\n              <Button\n                v-if=\"data.status === 'pending'\"\n                icon=\"pi pi-times\"\n                size=\"small\"\n                severity=\"danger\"\n                text\n                title=\"Reject\"\n                @click=\"handleReject(data.id, data.full_name)\"\n              />\n              <Button\n                v-if=\"data.status === 'active'\"\n                icon=\"pi pi-ban\"\n                size=\"small\"\n                severity=\"warn\"\n                text\n                title=\"Suspend\"\n                @click=\"handleSuspend(data.id, data.full_name)\"\n              />\n              <NuxtLink :to=\"`/admin/members/${data.id}`\">\n                <Button icon=\"pi pi-pencil\" size=\"small\" text title=\"Edit\" />\n              </NuxtLink>\n            </div>\n          </template>\n        </Column>\n      </DataTable>\n    </div>\n  </div>\n</template>\n"],"version":3}